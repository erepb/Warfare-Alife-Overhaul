<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName position="Left" colour="000000">Warfare ALife Overhaul</moduleName>
    <installSteps order="Explicit">
        <installStep name="">
            <optionalFileGroups order="Explicit">
                <group name="Main Files" type="SelectAny">
                    <plugins order="Ascending">
                        <plugin name="Warfare ALife Overhaul">
                            <!--<designer.metadata.do.not.edit> {"name":"Warfare ALife Overhaul"}-->
                            <description>
The core files of this addon.

NOTE ABOUT PATCHES: If you use any of the patches below, this addon must be loaded AFTER the addons you selected patches for!
                            </description>
                            <image path="AlifeOverhaulIcon3.jpg"/>
                            <files>
                                <folder source="src" destination="" priority="0"
                                        alwaysInstall="true" installIfUsable="false"/>
                            </files>
                            <typeDescriptor>
                                <type name="Required"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                    <!--<designer.metadata.do.not.edit> {"name":"Main Files"}-->
                </group>
                <group name="Faction HQs" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="HQ Renegade Base">
                            <description>
The renegade base in the Marsh (mar_smart_terrain_3_3) gets a trader, mechanic, barman and medic, a workbench, a bar, a medic corner and a sleep spot, in every game.

Uncheck it if another addon furnishes this base, for example Renegade Restoration.

HQ choices are per playthrough: start a new game after changing them.
                            </description>
                            <files>
                                <folder source="optionals\HQ Renegade Base" destination="" priority="0"
                                        alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <conditionFlags>
                                <flag name="hq_renegade">On</flag>
                            </conditionFlags>
                            <typeDescriptor>
                                <type name="Recommended"/>
                            </typeDescriptor>
                        </plugin>
                        <plugin name="HQ Sin Mine">
                            <description>
Playing Sin in Warfare, the Red Forest mine (red_smart_terrain_3_2) becomes your faction's HQ instead of the surface camp, with a medic and barman next to the Sin trader and mechanic, a workbench, a medic corner, a bar and a sleep spot. Not available with ReDone, which moves the Sin base.

Uncheck it if another addon furnishes this base.

HQ choices are per playthrough: start a new game after changing them.
                            </description>
                            <files>
                                <folder source="optionals\HQ Sin Mine" destination="" priority="0"
                                        alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <conditionFlags>
                                <flag name="hq_sin">On</flag>
                            </conditionFlags>
                            <typeDescriptor>
                                <type name="Recommended"/>
                            </typeDescriptor>
                        </plugin>
                        <plugin name="HQ UNISG Depot">
                            <description>
Playing UNISG in Warfare, the Jupiter depot (jup_b208) becomes your faction's HQ, with a trader, mechanic, medic and barman, an infirmary and a sleep spot. It is occupied at the start only when you start at the depot; from any other start it stands empty for you to capture.

Uncheck it if another addon furnishes this base.

HQ choices are per playthrough: start a new game after changing them.
                            </description>
                            <files>
                                <folder source="optionals\HQ UNISG Depot" destination="" priority="0"
                                        alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <conditionFlags>
                                <flag name="hq_unisg">On</flag>
                            </conditionFlags>
                            <typeDescriptor>
                                <type name="Recommended"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
                <group name="Optionals" type="SelectAny">
                    <!--<designer.metadata.do.not.edit> {"name":"Optionals"}-->
                    <plugins order="Ascending">
                        <plugin name="Fast Travel + Warfare mode Fix">
                            <!--<designer.metadata.do.not.edit> {"name":"Fast Travel + Warfare mode Fix"}-->
                            <description>
Fixes Fast Travel feature compatibility with Warfare mode. No more PDA icon incompatibility.
                            </description>
                            <files>
                                <folder source="optionals\Fix for Fast Travel + Warfare" destination="" priority="0"
                                        alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                        <plugin name="Beard invincible unless player is hostile">
                            <!--<designer.metadata.do.not.edit> {"name":"Beard invincible unless player is hostile"}-->
                            <description>
Beard is an essential NPC for the Living Legend questline.

Selecting this option makes Beard invincible as long as the player's faction is not hostile to Free STALKERs. This guarantees his survival if you play Living Legend as a faction that is neutral to loners.

If using this optional, this addon should be loaded after Trader Overhaul. May have issues with Beard's inventory if used without Trader Overhaul.
                            </description>
                            <files>
                                <folder source="optionals\Beard Invincible to all except hostile player" destination=""
                                        priority="0" alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                        <plugin name="Storymode area map spots restored">
                            <!--<designer.metadata.do.not.edit> {"name":"Storymode area map spots restored"}-->
                            <description>
Restores the story mode pda mapspots.

If using debug mode, may cause some issues with selecting the Warfare mapspot. Users will need to un-select the "Areas" filter in the PDA map in order to select the Warfare mapspot.
                            </description>
                            <files>
                                <folder source="optionals\Restored Map Area Spots" destination="" priority="0"
                                        alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
                <group name="Modpack" type="SelectAtMostOne">
                    <!--<designer.metadata.do.not.edit> {"name":"Patches"}-->
                    <plugins order="Ascending">
                        <plugin name="Gamma Patch">
                            <!--<designer.metadata.do.not.edit> {"name":"'Dynamic' addons"}-->
                            <description>
Contains all patches for Gamma modpack compatibility.
                            </description>
                            <files>
                                <folder source="patches\GAMMA Warfare Patch"
                                        destination="" priority="0" alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <conditionFlags>
                                <flag name="gamma">On</flag>
                            </conditionFlags>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
                <group name="Patches" type="SelectAny">
                    <!--<designer.metadata.do.not.edit> {"name":"Patches"}-->
                    <plugins order="Explicit">
                        <plugin name="Alternative New Levels Layout">
                            <!--<designer.metadata.do.not.edit> {"name":"Alternative New Levels Layout"}-->
                            <description>
Optional. New Levels is already warfare-ready on its own; this swaps its default layout for the one from "It's Warfare Time" by LostToTheSzone. The new maps (Promzone, Grimwood, Town Yuzhniy, Collaider, Bunker A1) get more faction bases, territories and starting squads, turning them into fuller battlegrounds.

Requires the New Levels addon.
                            </description>
                            <files>
                                <folder source="patches\New Levels Warfare Patch"
                                        destination="" priority="0" alwaysInstall="false" installIfUsable="false"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
    <conditionalFileInstalls>
        <patterns>
            <pattern>
                <dependencies operator="And">
                    <flagDependency flag="gamma" value="On"/>
                    <flagDependency flag="hq_sin" value="On"/>
                </dependencies>
                <files>
                    <folder source="patches\GAMMA HQ Sin Mine" destination="" priority="0"/>
                </files>
            </pattern>
            <pattern>
                <dependencies operator="And">
                    <flagDependency flag="gamma" value="On"/>
                    <flagDependency flag="hq_unisg" value="On"/>
                </dependencies>
                <files>
                    <folder source="patches\GAMMA HQ UNISG Depot" destination="" priority="0"/>
                </files>
            </pattern>
        </patterns>
    </conditionalFileInstalls>
</config>
