-- GAMMA part of the "HQ UNISG Depot" option, after GeroyAnekdotov's UNISG Command & Operations 1.0.3:
-- two campfires (Placeable Campfires' wood + a vanilla campfire zone) in the depot while the HQ is in
-- the world, in the depot's campfire list so its NPCs light and use them, and the conditions of the
-- seats by them (from 1.2.0).

local WOOD_SECTION = "ph_campfiremod"
local FIRE_SECTION = "campfire"

-- smart -> key -> wood position and heading (the fire is radial)
local campfires = {
    jup_b208 = {
        hall  = { pos = { 400.152, 4.279, -130.446 }, heading = 0.14130 },
        hall2 = { pos = { 399.007, 4.279, -94.434 },  heading = 3.11059 },
    },
}

-- Same offset and zone shape as GAMMA's campfire_placeable.spawn_anomaly_campfire. The wood keeps its
-- section's own model, bones and logic.
local function create_campfire(c, gvid)
    local p = c.pos
    local pos = vector():set(p[1], p[2], p[3])
    local lvid = warfare_utils.nearest_lvid(pos)
    local wood = lvid and alife_create(WOOD_SECTION, pos, lvid, gvid)
    if not wood then
        return
    end
    wood.angle = vector():set(0, c.heading, 0)

    local fire_pos = vector():set(p[1] - 0.05, p[2] + 0.20, p[3] + 0.05)
    local fire_lvid = warfare_utils.nearest_lvid(fire_pos)
    local fire = fire_lvid and alife_create(FIRE_SECTION, fire_pos, fire_lvid, gvid)
    if not fire then
        alife_release(wood)
        return
    end
    local data = utils_stpk.get_anom_zone_data(fire)
    data.shapes = { { shtype = 0, offset = vector():set(0, 10, 0), center = vector():set(0, 0, 0), radius = 0.85 } }
    utils_stpk.set_anom_zone_data(data, fire)
    return { wood = wood.id, fire = fire.id }
end

local function hq_active(smart_name)
    for _, hq in ipairs(warfare_player_hqs.active()) do
        if hq.smart == smart_name then
            return true
        end
    end
    return false
end

local function exists(id, section)
    local se_obj = id and alife_object(id)
    return se_obj and se_obj:section_name() == section
end

local function place_campfires()
    if not ini_sys:section_exist(WOOD_SECTION) then
        return
    end
    local st = alife_storage_manager.get_state()
    for smart_name, list in pairs(campfires) do
        local smart = warfare_utils.smart_on_actor_level(smart_name)
        if smart and hq_active(smart_name) then
            st.warfare_hq_campfires = st.warfare_hq_campfires or {}
            local ids = st.warfare_hq_campfires[smart_name] or {}
            for key, c in pairs(list) do
                local rec = ids[key]
                if not (rec and exists(rec.wood, WOOD_SECTION) and exists(rec.fire, FIRE_SECTION)) then
                    if rec and exists(rec.wood, WOOD_SECTION) then
                        alife_release(alife_object(rec.wood))
                    end
                    if rec and exists(rec.fire, FIRE_SECTION) then
                        alife_release(alife_object(rec.fire))
                    end
                    ids[key] = create_campfire(c, smart.m_game_vertex_id)
                    warfare_log.info("warfare_hq_unisg_gamma: campfire smart=%s key=%s created=%s", smart_name, key, ids[key] ~= nil)
                end
            end
            st.warfare_hq_campfires[smart_name] = ids
        end
    end
end

-- bind_campfire lists a fire under the smart its name starts with; these are named after their id.
local function hq_fire_smart(id)
    local st = alife_storage_manager.get_state()
    for smart_name, ids in pairs(st.warfare_hq_campfires or {}) do
        for _, rec in pairs(ids) do
            if rec.fire == id then
                return smart_name
            end
        end
    end
end

local function install_campfire_registry()
    local binder = bind_campfire and bind_campfire.campfire_binder
    if not binder then
        return
    end
    local net_spawn, net_destroy = binder.net_spawn, binder.net_destroy
    function binder:net_spawn(se_abstract)
        if not net_spawn(self, se_abstract) then
            return false
        end
        local id = self.object:id()
        local smart_name = hq_fire_smart(id)
        if smart_name then
            db.campfire_table_by_smart_names[smart_name] = db.campfire_table_by_smart_names[smart_name] or {}
            db.campfire_table_by_smart_names[smart_name][id] = self
        end
        return true
    end
    function binder:net_destroy(...)
        local id = self.object:id()
        local smart_name = hq_fire_smart(id)
        local fires = smart_name and db.campfire_table_by_smart_names[smart_name]
        if fires then
            fires[id] = nil
        end
        return net_destroy(self, ...)
    end
end

-- smart -> campfire key -> the seat by that fire (jup_b208_warfare_campfire_logic.ltx): its level
-- vertex and position
local seats = {
    jup_b208 = {
        hall  = { vertex = 1346838, pos = { 400.4, 4.2678, -132.3 } },
        hall2 = { vertex = 1345732, pos = { 399.7, 4.2678, -92.4 } },
    },
}
local SEAT_FREE_RADIUS = 0.85

local function online_fire(smart_name, key)
    local st = alife_storage_manager.get_state()
    local ids = st.warfare_hq_campfires and st.warfare_hq_campfires[smart_name]
    local id = ids and ids[key] and ids[key].fire
    local fires = id and db.campfire_table_by_smart_names[smart_name]
    local binder = fires and fires[id]
    return binder and binder.campfire and binder
end

-- suitable of a seat job, params smart:key. Its fire is online, and the seat is reachable and not
-- taken by another NPC, a vertex claim or a campfire_point job.
local function campfire_seat(actor, npc, p)
    local smart_name, key = p[1], p[2]
    local seat = seats[smart_name] and seats[smart_name][key]
    if not (seat and online_fire(smart_name, key)) then
        return false
    end
    local id = type(npc.id) == "function" and npc:id() or npc.id
    local obj = level.object_by_id(id)
    if not (obj and obj:alive()) or obj:best_enemy() or xr_danger.has_danger(obj)
            or obj:has_info("npcx_is_companion") then
        return false
    end

    local pos = vector():set(seat.pos[1], seat.pos[2], seat.pos[3])
    local vertex = seat.vertex
    local claim = db.used_level_vertex_ids[vertex]
    if level.vertex_id(pos) ~= vertex or (claim and claim ~= id) or not obj:accessible(vertex) then
        return false
    end
    local smart = SIMBOARD.smarts_by_names[smart_name]
    for other in pairs(smart and smart.npc_info or {}) do
        local st = db.storage[other]
        local camp = other ~= id and st and st.active_scheme == "campfire_point" and st.campfire_point
        if camp and camp.vid == vertex then
            return false
        end
    end

    local free = true
    level.iterate_nearest(pos, SEAT_FREE_RADIUS, function(o)
        if o:id() ~= id and o:position():distance_to_sqr(pos) <= SEAT_FREE_RADIUS * SEAT_FREE_RADIUS then
            free = false
            return true
        end
    end)
    return free
end

-- params smart:key: the seat's fire is online and out
local function campfire_unlit(actor, npc, p)
    local binder = online_fire(p[1], p[2])
    if not binder then
        return false
    end
    return not binder.campfire:is_on()
end

function on_game_start()
    -- the seat jobs are in the depot's config in every game, so their conditions must always exist
    xr_conditions.warfare_hq_campfire_seat = campfire_seat
    xr_conditions.warfare_hq_campfire_unlit = campfire_unlit
    warfare.on_enabled(function()
        install_campfire_registry()
        RegisterScriptCallback("actor_on_first_update", place_campfires)
    end)
end
