-- These mods stay out of warfare games. Their on_game_start only registers callbacks, and it runs
-- before the mode of a loaded save is known, so it is deferred to on_game_load.
local function outside_warfare(mod)
    local on_game_start = mod and mod.on_game_start
    if not on_game_start then
        return
    end
    mod.on_game_start = function()
        RegisterScriptCallback("on_game_load", function()
            if not _G.WARFARE then
                on_game_start()
            end
        end)
    end
end

outside_warfare(emission_guard_patch)
outside_warfare(grok_nes)
outside_warfare(grok_no_north_faction_in_south)

function get_random_faction(smart, guard)
    if _G.WARFARE and smart.owning_faction and smart.owning_faction ~= "none" then
        return smart.owning_faction
    end

    local random_faction = is_not_empty(guard.factions) and guard.factions[math.random(#guard.factions)]
    random_faction = guards_spawner.faction_name_replace[random_faction] or random_faction
    return random_faction
end

local old_guards_spawner_spawn_guard = guards_spawner.spawn_guard
guards_spawner.spawn_guard = function()
    if not _G.WARFARE then
        return old_guards_spawner_spawn_guard()
    end
    local cur_game_time = warfare.get_time_ref()
    if (guards_spawner.upd_tmr and guards_spawner.upd_tmr:diffSec(cur_game_time) > 0) then
        return
    end
    guards_spawner.upd_tmr = warfare_utils.add_time(cur_game_time, 540)
    if not guards_spawner.prev_time then
        guards_spawner.prev_time = guards_spawner.ctime_to_t(cur_game_time)
    end

    local time_diff = cur_game_time:diffSec(guards_spawner.t_to_ctime(guards_spawner.prev_time))
    if time_diff < guards_spawner.spawn_timer then
        guards_spawner.pr("~ time_diff < spawn_timer || %s < %s", math.ceil(time_diff), guards_spawner.spawn_timer)
        return
    end

    guards_spawner.prev_time = guards_spawner.ctime_to_t(cur_game_time)

    guards_spawner.pr("------------- Spawning Squads -------------")
    for smart_name, t in pairs(guards_spawner.guards_t) do
        guards_spawner.pr("=================")
        if t.max_amount > 0 and ((not guards_spawner.guarded_smarts[smart_name]) or (#guards_spawner.guarded_smarts[smart_name] < t.max_amount)) then
            local smart = SIMBOARD:get_smart_by_name(smart_name)

            -- build squad section
            local random_faction = get_random_faction(smart, t)
            local random_rank = is_not_empty(t.ranks) and t.ranks[math.random(#t.ranks)]
            local squad_section = (random_faction and random_rank) and random_faction .. "_sim_squad_" .. random_rank
            squad_section = guards_spawner.squad_replace[squad_section] or squad_section

            -- replace squads if "squads" field filled
            if t.squads and is_not_empty(t.squads) then
                squad_section = t.squads[math.random(#t.squads)]
            end

            -- spawn squad
            local squad = smart and squad_section and ini_sys:section_exist(squad_section) and SIMBOARD:create_squad(smart, squad_section)

            -- set this smart as target and add squad.id to table
            if squad then
                guards_spawner.guarded_smarts[smart_name] = guards_spawner.guarded_smarts[smart_name] or {}
                table.insert(guards_spawner.guarded_smarts[smart_name], squad.id)
                guards_spawner.pr("Spawning at smart_name: [ %s ] || squad_section: [ %s ] || current_amount: [ %s ] || max_amount: [ %s ]", smart_name, squad_section, #guards_spawner.guarded_smarts[smart_name], t.max_amount)
                squad.scripted_target = smart_name
            end

        else
            guards_spawner.pr("# No spawn, smart_name: [ %s ] || guards_amount: [ %s ] || max_amount: [ %s ]", smart_name, #guards_spawner.guarded_smarts[smart_name], t.max_amount)
        end
    end
    guards_spawner.pr("---------------------------------------------")
end

-- Story-NPC shield: a listed NPC keeps its NPC/monster damage cut only in story mode while not an
-- enemy of the actor; otherwise NPCs and monsters hit it at that mod's player rate.
-- Must install at load time, before the mods' on_game_start registers npc_on_before_hit.

local function is_shielded(npc)
    return IsStoryMode() and not game_relations.is_factions_enemies(get_actor_true_community(), character_community(npc))
end

local function is_unshielded_npc_hit(npc, s_hit)
    if not _G.WARFARE then
        return false
    end
    local draftsman = s_hit.draftsman
    return draftsman and draftsman:id() ~= AC_ID and not is_shielded(npc) or false
end

local grok = grok_additional_storyline_npc_invincible
if grok and grok.ads_npcs then
    local grok_npc_on_before_hit = grok.npc_on_before_hit
    -- Runs grok's player branch with the actor as draftsman. The engine applies draftsman back as
    -- the hit source, so it must always be restored.
    grok.npc_on_before_hit = function(npc, s_hit, bone_id, flags)
        if npc and grok.ads_npcs[npc:section()] and is_unshielded_npc_hit(npc, s_hit) then
            local draftsman = s_hit.draftsman
            s_hit.draftsman = db.actor
            local ok, e = pcall(grok_npc_on_before_hit, npc, s_hit, bone_id, flags)
            s_hit.draftsman = draftsman
            if not ok then
                error(e, 0)
            end
            return
        end
        return grok_npc_on_before_hit(npc, s_hit, bone_id, flags)
    end
end

local hxf = hxf_tough_important_npcs
if hxf then
    if hxf.IMPORTANT_NPC_SECTIONS and hxf.PLAYER_IMPORTANT_DMG then
        local hxf_npc_on_before_hit = hxf.npc_on_before_hit
        hxf.npc_on_before_hit = function(npc, s_hit, bone_id, flags)
            if npc and hxf.IMPORTANT_NPC_SECTIONS[npc:section()] and not npc:has_info("npcx_is_companion") and is_unshielded_npc_hit(npc, s_hit) then
                s_hit.power = s_hit.power * hxf.PLAYER_IMPORTANT_DMG
                return
            end
            return hxf_npc_on_before_hit(npc, s_hit, bone_id, flags)
        end
    else
        warfare_log.warn("gamma_patch: hxf_tough_important_npcs locals not unlocalized, story-NPC shield left off for it")
    end
end