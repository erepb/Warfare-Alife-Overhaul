-- GAMMA hazards inside the installed HQs (warfare_player_hqs.hazard_free), after GeroyAnekdotov's WALO
-- SIN HQ 2.0.2 and UNISG Command & Operations 1.0.3: Dynamic Anomalies Overhaul spawns no new
-- anomaly inside the actor's HQ, nor GAMMA's Radiation Dynamic Areas a radiation field. Saved ones
-- are left alone. With no HQ hazard rows installed nothing is wrapped. The HQs' other GAMMA parts
-- ship with their options (patches\GAMMA HQ *).

local function install_dao_filter()
    local dao = drx_da_main
    if not dao then
        return
    end
    local spawn_anomaly_on_smart = dao.drx_da_spawn_anomaly_on_smart
    dao.drx_da_spawn_anomaly_on_smart = function(level_file, smart_name, anomaly_type, level_name, position_data)
        local _, smart = warfare_player_hqs.current_hq()
        if smart and smart == smart_name then
            return false
        end
        return spawn_anomaly_on_smart(level_file, smart_name, anomaly_type, level_name, position_data)
    end

    local spawn_anomaly = dao.drx_da_spawn_anomaly
    dao.drx_da_spawn_anomaly = function(anom_type, pos, lvid, gvid, level_file)
        if warfare_player_hqs.hazard_free(level.name(), pos) then
            return nil
        end
        return spawn_anomaly(anom_type, pos, lvid, gvid, level_file)
    end
end

-- Generated at the new game's on_game_load, a field per smart picked at random.
local function install_radiation_filter()
    local radiation = gamma_dynamic_radiation_areas_from_arzsi
    local create = radiation and radiation.create_radiation_field
    if type(create) ~= "function" then
        return
    end
    radiation.create_radiation_field = function(anomaly_type, position, game_vertex_id, level_vertex_id, radius, ...)
        local vertex = game_vertex_id and game_graph():vertex(game_vertex_id)
        local level_name = vertex and alife():level_name(vertex:level_id())
        if level_name and warfare_player_hqs.hazard_free(level_name, position) then
            warfare_log.info("warfare_player_hqs_gamma_patch: no radiation field section=%s level=%s, inside the HQ", anomaly_type, level_name)
            return
        end
        return create(anomaly_type, position, game_vertex_id, level_vertex_id, radius, ...)
    end
end

function on_game_start()
    if not warfare_player_hqs.any("hazard_free") then
        return
    end
    install_dao_filter()
    warfare.on_enabled(install_radiation_filter)
end
