-- Install option "HQ Renegade Base": the renegade base mar_smart_terrain_3_3, in every game, gets a
-- trader, mechanic, barman and medic (mod_simulation_warfare_hq_renegade.ltx, jobs in
-- mod_mar_smart_terrain_3_3_warfare.ltx), a workbench, bar, medic corner and sleep spot.
-- Read by warfare_player_hqs.

local k = warfare_base_props.kit

-- A level vertex is blocked when a corner of its cell is inside. The barman's cell has no cells north
-- of it, so this must stay below 0.28 to keep the two cells west of it open as his way in.
local BARREL_RADIUS = 0.25

hq = {
    id    = "renegade",
    smart = "mar_smart_terrain_3_3",
    gate  = "always",

    warfare = {
        uniques = { 1, 1, 1, 1, 0 },                            -- trader, mechanic, medic, barman
    },

    pieces = {
        -- Workbench: the Clear Sky base pair (mar_awr_stol_1 + mar_awr_tiski_01) rotated so the table's
        -- working side faces the mechanic.
        { key = "table", section = k.PHYSIC_OBJECT, visual = k.TABLE, fixed_bones = "link",
          pos = { -205.03261, 0.60585, 404.34882 }, heading = 0.90970 },
        { key = "vice", section = "awr_tiski", ini = k.VICE_INI,
          pos = { -204.85197, 1.45720, 404.22124 }, heading = 5.62133 },

