-- Install option "HQ UNISG Depot", after GeroyAnekdotov's WALO UNISG Command & Operations: in full
-- warfare, whoever the actor plays, the Jupiter depot jup_b208 is a UNISG main base, protected only
-- for a UNISG actor, with a trader, mechanic, medic and barman (jobs in mod_jup_b208_warfare.ltx),
-- chairs, an infirmary and a sleep spot. Read by warfare_player_hqs.

local k = warfare_base_props.kit

hq = {
    id      = "unisg",
    smart   = "jup_b208",                                       -- the depot
    faction = "isg",
    gate    = "warfare",

    warfare = {
        entry    = { faction = "isg", protect = "actor", resurrect = true },
        props    = {
            jup_b208 = { base = 1, isg = 1 },
