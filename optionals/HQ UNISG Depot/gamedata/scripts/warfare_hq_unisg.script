                     "jup_b208_isg_medic_squad", "jup_b208_isg_barman_squad" },
        -- new_game_start_locations.ltx: from any other start, or for another faction, the depot is
        -- left empty to be captured
        seed_start = "yanov_depo_monolith",
    },

    -- Laid out by UNISG Command & Operations 1.0.3: the medic's and barman's chairs, and an infirmary
