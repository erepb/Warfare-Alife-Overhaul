; Warfare roles of individual smarts, one section per smart name. Every key is optional.
;
;   main_base      = <faction>   the smart is that faction's main base (home)
;   protect        = true        shielded from inbound targeting while that faction holds it
;                                (prevent_mainbase_attacks), keeps its last squad, and other
;                                factions are never resurrected onto it
;   resurrect      = true        resurrection anchor for the faction (homeland preference)
;   resurrect_also = <factions>  comma list of further factions using it as an anchor
;   travel_hub     = <weight>    independent factions prefer it when falling back to a base
;   lab_entrance   = true        weighted by the lab_entrance_appeal trait
;   inherit_trade  = true        the warfare trader keeps the trade profile of the job it takes here
;                                whoever holds the smart; goodwill gates on the main_base faction
;                                follow the trader's own faction instead
;
; Level packs add their own smarts with misc\mod_warfare_smarts_<pack>.ltx; `![smart]` amends an
; entry here and `!![smart]` removes it. A section for a smart that is not in the game is ignored.

; --- Clear Sky / Renegade ---
[mar_smart_terrain_base]                     ; Clear Sky Base
main_base      = csky
protect        = true
resurrect      = true
travel_hub     = 1

[mar_smart_terrain_3_3]
