; UNISG trader tasks for a UNISG player under warfare, from UNISG Command & Operations 1.0.3
; (GeroyAnekdotov), matching the other factions' trader tasks in tm_warfare.ltx. The GAMMA Warfare
; Patch adds the one built on GAMMA's fetch lists.

[sim_default_isg_trader_task_1]
icon = ui_inGame2_Nochnaya_ohota
prior = 15
storyline = false
title = unisg_hq_trader_task_1_title
descr = unisg_hq_trader_task_1_descr
job_descr = unisg_hq_trader_task_1_job
task_complete_descr = unisg_hq_trader_task_1_finish
repeat_timeout = 86400
stage_complete = 1
descr_functor = general_warfare_task
status_functor = assault_task_status_functor
target_functor = assault_task_target_functor
status_functor_params = monster, monster_predatory_day, monster_predatory_night, monster_vegetarian, monster_zombied_day, monster_zombied_night, monster_special
on_job_descr = %=setup_assault_task(sim_default_isg_trader_task_1)%
precondition = {=is_warfare =is_actor_from_faction(isg) =validate_assault_task(sim_default_isg_trader_task_1:1:1:nil:false:true:nil)} true, false
on_complete = %=inc_task_stage(sim_default_isg_trader_task_1) =reward_random_money(2500:5000) =reward_stash(true) =complete_task_inc_goodwill(35:isg)%
condlist_0 = {!task_giver_alive(sim_default_isg_trader_task_1)} fail

