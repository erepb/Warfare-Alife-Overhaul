; Sin HQ services (warfare_player_hqs): the medic and barman warfare spawns at the mine while the
; Sin HQ is in the world. Positions from SIN HQ 2.0.2. The story trader and mechanic keep their own jobs.

; Warfare-spawned medic, sitting at the table created by warfare_base_props.script. He walks to the
; cell beside the chair (pos), and the animation is placed on the seat (animpoint).
; warfare_job_anchors keeps beh from standing him up there and walks him round the table.
[logic@red_smart_terrain_3_2_warfare_medic]
suitable = {=check_npc_medic} true
trade = items\trade\trade_generic_medic.ltx
prior = 200
active = beh@red_smart_terrain_3_2_warfare_medic
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = medic

; Warfare-spawned barman, behind the barrels created by warfare_base_props.script.
[logic@red_smart_terrain_3_2_warfare_barman]
suitable = {=check_npc_barman} true
trade = items\trade\trade_generic_barman.ltx
prior = 200
active = beh@red_smart_terrain_3_2_warfare_barman
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = barman

[beh@general]
behavior_state = beh_move
target = waypoint
walk_dist = 100
jog_dist = 220
wait_anim = guard
walk_anim = patrol
jog_anim = patrol
run_anim = rush
delay_anim = guard
use_camp = false
meet = meet
combat_ignore_cond = {=is_warfare} false, {=actor_true_enemy =check_enemy_name(actor)} false, true
combat_ignore_keep_when_attacked = {=is_warfare} false, true
invulnerable = {=is_warfare} false, {!actor_true_enemy} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

; The wait never runs out, so he stays seated.
[beh@red_smart_terrain_3_2_warfare_medic]:beh@general
pt1 = 1000000000,animpoint_sit_normal | pos:-156.97091674805,2.1770622730255,-36.311023712158 animpoint:-156.770994,2.180062,-36.316586,-0.999613179,0,0.027811744
path_end = loop

[beh@red_smart_terrain_3_2_warfare_barman]:beh@general
pt1 = 1000000000,guard | pos:-152.677971,2.200348,-18.637812 look:-152.722690,2.200348,-19.586759
path_end = loop

[meet]
close_anim      = nil
close_victim    = nil
far_anim        = nil
far_victim      = nil
close_distance  = 0
far_distance    = 0
close_snd_distance = 3
abuse           = false
use = {=actor_enemy} false, true
allow_break = false
meet_on_talking = false
trade_enable = false
