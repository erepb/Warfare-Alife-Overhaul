#include "common.h"

struct 	v2p
{
	float2 	tc0: 	TEXCOORD0;
	float4	c0:		COLOR0;
};

// half-desaturate and gamma-lift: a washed-out "old intel" look that keeps the faction hue
float3 fade ( float3 rgb )
{
	float l = dot( rgb, float3( 0.299, 0.587, 0.114 ) );
	return pow( saturate( lerp( l.xxx, rgb, 0.5 ) ), 0.6 );
}

// faded icon with a one-screen-pixel unsharp mask (low-contrast emblems such as Monolith
// otherwise flatten into a plain disc), then tinted by the vertex colour.
// Entry is "main" so the renderer picks the device's best profile (ddx/ddy need ps_3_0).
float4 	main	( v2p I )	: COLOR
{
	float2 dx = ddx( I.tc0 );
	float2 dy = ddy( I.tc0 );
	float4 t  = tex2D( s_base, I.tc0 );
	float3 n  = ( tex2D( s_base, I.tc0 + dx ).rgb
	            + tex2D( s_base, I.tc0 - dx ).rgb
	            + tex2D( s_base, I.tc0 + dy ).rgb
	            + tex2D( s_base, I.tc0 - dy ).rgb ) * 0.25;
	float3 c  = fade( t.rgb );
	c = saturate( c + ( c - fade( n ) ) * 3.0 );
	return float4( c * I.c0.rgb, t.a * I.c0.a );
}
