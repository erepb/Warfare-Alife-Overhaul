--[[
    Per-faction behavior preset row -- alife/warfare/<faction>/behavior_preset.

    Stored value is the base ("lore" | "generic"); picking one stamps the trait rows through
    CacheValue. The combobox text is derived: the base while every trait matches it, "custom"
    otherwise. "custom" is display-only. The row registers itself because vanilla keeps no
    handle to a list's combobox.
--]]

local ROW     = "behavior_preset"
local STR_LST = "ui_mm_lst_"          -- mirrors ui_options' file-local opt_str_lst
local CUSTOM  = STR_LST .. "wf_preset_custom"

-- The one preset combobox on the current page, replaced on every registration.
local shown = nil

local function faction_of(path)
    return string.match(path, "^alife/warfare/([%w_]+)$")
end

local function preset_value(faction, base, name)
    if base == "generic" then
        return warfare_behavior.TRAITS[name].neutral
    end
    return warfare_behavior.default(faction, name)
end

local function is_custom(path, faction, base)
    for _, name in ipairs(warfare_behavior.TRAIT_ORDER) do
        local id = ui_options.cc(path, name)
        local row = ui_options.get_opt_table(id)
        if modxml_warfare_presets.current_value(id, row) ~= preset_value(faction, base, name) then
            return true
        end
    end
    return false
end

local function label_for(path, v, base)
    local faction = faction_of(path)
    if is_custom(path, faction, base) then
        return game.translate_string(CUSTOM)
    end
    for i = 1, #v.content do
        if v.content[i][1] == base then
            return game.translate_string(STR_LST .. v.content[i][2])
        end
    end
    return tostring(base)
end

local function refresh_label(path)
    if not (shown and shown.path == path) then
        return
    end
    local base = modxml_warfare_presets.current_value(ui_options.cc(path, ROW), shown.v)
    shown.ctrl:SetText(label_for(path, shown.v, base))
end

local function stamp(dlg, path, base)
    local faction = faction_of(path)
    for _, name in ipairs(warfare_behavior.TRAIT_ORDER) do
        local row = ui_options.get_opt_table(ui_options.cc(path, name))
        dlg:CacheValue(path, name, preset_value(faction, base, name), row)
    end
    warfare_log.info("modxml_warfare_behavior_presets.stamp: %s <- %s", tostring(path), tostring(base))
end

--------------------------------------------------------------------------------------
-- Registration: vanilla's Register_List body, plus the derived label and the handle.
--------------------------------------------------------------------------------------

local base_Register_List = ui_options.UIOptions.Register_List
function ui_options.UIOptions.Register_List(self, xml, handler, path, opt, v, flags)
    if not (opt == ROW and faction_of(path)) then
        return base_Register_List(self, xml, handler, path, opt, v, flags)
    end

    local id = ui_options.cc(path, opt)
    local h = self:Register_Cap(xml, handler, id, v.hint)

    if flags.apply_to_all and flags.group then
        self:Register_BtnAll(xml, handler, path, opt, v, flags)
    end

    local ctrl = xml:InitComboBox("elements:list", handler)

    local base = self:GetValue(path, opt, v, flags)
    local content = self:GetContent(path, opt, v)
    for i = 1, #content do
        ctrl:AddItem(game.translate_string(STR_LST .. content[i][2]), i)
    end
    ctrl:SetText(label_for(path, v, base))
    shown = { path = path, v = v, ctrl = ctrl }

    local id_ctrl = self:Stacker(path, opt, v)
    self:Register(ctrl, id_ctrl)
    self:AddCallback(id_ctrl, ui_events.LIST_ITEM_SELECT, function()
        self:Callback_List(ctrl, path, opt, v)
    end, self)

    return h
end

--------------------------------------------------------------------------------------
-- Callbacks: the row stamps; any trait edit re-derives the label.
--------------------------------------------------------------------------------------

local base_Callback_List = ui_options.UIOptions.Callback_List
function ui_options.UIOptions.Callback_List(self, ctrl, path, opt, v)
    base_Callback_List(self, ctrl, path, opt, v)
    if opt == ROW and faction_of(path) then
        local content = self:GetContent(path, opt, v)
        stamp(self, path, content[ctrl:CurrentID()][1])
        modxml_warfare_ui.request_rebuild(self)
    elseif warfare_behavior.TRAITS[opt] then
        refresh_label(path)
    end
end

local base_Callback_Check = ui_options.UIOptions.Callback_Check
function ui_options.UIOptions.Callback_Check(self, ctrl, path, opt, v)
    base_Callback_Check(self, ctrl, path, opt, v)
    if warfare_behavior.TRAITS[opt] then
        refresh_label(path)
    end
end

local base_Callback_Track = ui_options.UIOptions.Callback_Track
function ui_options.UIOptions.Callback_Track(self, ctrl, path, opt, v, value)
    base_Callback_Track(self, ctrl, path, opt, v, value)
    if warfare_behavior.TRAITS[opt] then
        refresh_label(path)
    end
end

-- "Apply to all" on the row stamps every faction.
local base_Callback_BtnAll = ui_options.UIOptions.Callback_BtnAll
function ui_options.UIOptions.Callback_BtnAll(self, ctrl, path, opt, v, flags)
    base_Callback_BtnAll(self, ctrl, path, opt, v, flags)
    if opt == ROW and faction_of(path) then
        local base = modxml_warfare_presets.current_value(ui_options.cc(path, opt), v)
        for _, faction in ipairs(warfare_factions.factions) do
            stamp(self, "alife/warfare/" .. faction, base)
        end
        modxml_warfare_ui.request_rebuild(self)
    elseif warfare_behavior.TRAITS[opt] then
        refresh_label(path)
    end
end
