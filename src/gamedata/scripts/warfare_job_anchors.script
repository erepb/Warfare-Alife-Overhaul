-- Keeps Warfare base NPCs on beh job spots that props wall in (warfare_base_props).
--
-- AI paths ignore physics objects, so an NPC walks into them and gets stuck. An NPC on an anchored job
-- that is walking within range of its spot is placed on the job's beh cell (pos). A standing NPC is
-- never moved, nor one within SEAT_RADIUS of its seat.
--
-- seat is where an animpoint animation settles the NPC. beh counts it arrived only while its level
-- vertex is pos's cell, and a seat off the AI graph resolves to whichever neighbouring cell is nearest,
-- which changes as the animation slides it, so beh stands it up. Within SEAT_RADIUS of its seat, beh
-- is made to treat the NPC's current cell as the target.

local RANGE = 1.5
local SNAP = 0.5
local SEAT_RADIUS = 0.8
local UPDATE_MS = 250

-- job is the smart job section; its logic is logic@<job> and its beh section beh@<job>.
-- pos is the beh point's pos.
local anchors = {
    -- seat = warfare_base_props' medic_chair
    { smart = "mar_smart_terrain_3_3", job = "mar_smart_terrain_3_3_warfare_medic",
      pos = { -171.5, 2.50729, 416.5 }, seat = { -171.74308, 2.48869, 415.71453 } },
    -- the faction HQs (warfare_player_hqs); seats = warfare_base_props' chairs
    { smart = "red_smart_terrain_3_2", job = "red_smart_terrain_3_2_warfare_medic",
      pos = { -156.97092, 2.17706, -36.31102 }, seat = { -157.27080, 2.18006, -36.30268 } },
    { smart = "jup_b208", job = "jup_b208_warfare_medic",
      pos = { 387.757, 4.279, -125.742 }, seat = { 386.95700, 4.27900, -125.72850 } },
    { smart = "jup_b208", job = "jup_b208_warfare_barman",
      pos = { 424.385, 9.954, -81.692 }, seat = { 425.18500, 9.95400, -81.68050 } },
}

local level_anchors -- anchors on the current level, built on first update
local seats = {}    -- beh section -> seat, for the anchors on the current level
local next_update = 0

local function to_vector(p)
    return vector():set(p[1], p[2], p[3])
end

local function actor_on_first_update()
    seats = {}
    level_anchors = {}
    for _, a in ipairs(anchors) do
        local smart = warfare_utils.smart_on_actor_level(a.smart)
        if smart and warfare_player_hqs.allows(a.smart) then
            local beh = "beh@" .. a.job
            local seat = a.seat and to_vector(a.seat)
            level_anchors[#level_anchors + 1] = { smart = smart, logic = "logic@" .. a.job, beh = beh,
                pos = to_vector(a.pos), seat = seat }
            seats[beh] = seat
        end
    end
end

local function near_seat(npc)
    local st = db.storage[npc:id()]
    local seat = st and seats[st.active_section]
    return seat and npc:position():distance_to(seat) < SEAT_RADIUS
end

local function patch_beh_arrival()
    local beh_path = axr_beh.action_beh.beh_path
    axr_beh.action_beh.beh_path = function(self)
        local target = self.st.desired_target
        if not (target and target.level_vertex_id and near_seat(self.object)) then
            return beh_path(self)
        end
        local lvid = target.level_vertex_id
        target.level_vertex_id = self.object:level_vertex_id()
        beh_path(self)
        target.level_vertex_id = lvid
    end
end

local function actor_on_update()
    if not (level_anchors and #level_anchors > 0) then
        return
    end
    local now = time_global()
    if now < next_update then
        return
    end
    next_update = now + UPDATE_MS

    for _, a in ipairs(level_anchors) do
        local id = a.smart.npc_by_job_section and a.smart.npc_by_job_section[a.logic]
        local npc = id and level.object_by_id(id)
        local st = npc and db.storage[id]
        local state = st and st.state_mgr and state_lib.states[st.state_mgr.target_state]
        if state and npc:alive() and st.active_section == a.beh and not npc:best_enemy()
                and state.movement ~= move.stand then
            -- state_mgr places an animpoint animation only while this is unset, and never clears it after
            -- a walk, so without this a second sit plays wherever the NPC stands.
            st.state_mgr.animation_direction_applied = nil

            local pos = npc:position()
            local dist = pos:distance_to(a.pos)
            local seated = a.seat and pos:distance_to(a.seat) < SEAT_RADIUS
            if not seated and dist > SNAP and dist < RANGE then
                npc:set_npc_position(a.pos)
                warfare_log.debug("warfare_job_anchors: anchored npc=%s job=%s from dist=%s", npc:name(), a.logic, dist)
            end
        end
    end
end

function on_game_start()
    patch_beh_arrival()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
