-- ReDone Collection (South 2.x / North 1.x) compatibility. Inert unless ReDone is installed.
-- ReDone moves faction traders onto smarts warfare does not treat as main bases; each entry
-- applies only when the squad section's target_smart is the one ReDone gives it.

local service_bases = {
    -- North: Sin (greh) live in the Hospital catacombs instead of the Red Forest.
    { squad = "kat_greh_trader_squad",            smart = "katacomb_smart_terrain",
      entry = { faction = "greh",     protect = true, resurrect = true  } },
    -- North: Monolith trader at the Red Forest mine.
    { squad = "monolith_bridge_trader_mlr_squad", smart = "red_smart_terrain_3_2",
      entry = { faction = "monolith", protect = true, resurrect = false } },
    -- South: renegade mechanic at the Marsh farmstead.
    { squad = "mar_renegade_mechanic_squad",      smart = "mar_smart_terrain_4_5",
      entry = { faction = "renegade", protect = true, resurrect = false } },
}

-- the Sin main base in misc\warfare_smarts.ltx
local sin_mine = "red_smart_terrain_3_2"

local function targets(squad, smart)
    return ini_sys:section_exist(squad) and ini_sys:r_string_ex(squad, "target_smart") == smart
end

-- ReDone North moves the Sin base to the Hospital catacombs.
function moves_sin_base()
    return targets("kat_greh_trader_squad", "katacomb_smart_terrain")
end

-- The mine stops being the Sin base first: North gives it to the Monolith trader.
local function apply()
    if moves_sin_base() then
        smart_terrain_warfare.set_main_base(sin_mine, nil)
        warfare_log.info("redone: %s is no longer a greh main base", sin_mine)
    end
    for _, s in ipairs(service_bases) do
        if targets(s.squad, s.smart) then
            smart_terrain_warfare.set_main_base(s.smart, s.entry)
            warfare_log.info("redone: %s is now a %s main base", s.smart, s.entry.faction)
        end
    end
end

function on_game_start()
    warfare.on_sim(apply)
end
