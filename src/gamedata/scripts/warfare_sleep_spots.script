-- Sleep prompts at beds that are part of the level geometry, for bases that have no
-- all.spawn sleep zone. Near a spot the vanilla tutorial_sleep prompt is shown; its use
-- action calls ui_sleep_dialog.sleep_in_zone by name, which is wrapped to accept the spot.
--
-- Each spot also gets a small space restrictor, created once the first time the actor is on its
-- level (id kept in alife storage), that carries the PDA sleep map spot the way vanilla sleep
-- zones do. It is "NOT A restrictor", so AI ignores it.

local RADIUS = 1.5
local UPDATE_MS = 250
local MARKER_SECTION = "space_restrictor"
local NOT_A_RESTRICTOR = 3
local MAP_SPOT = "ui_pda2_actor_sleep_location"
local MAP_HINT = "st_ui_pda_sleep_place"

-- smart name (resolves the level) -> bed position
local spots = {
    ["mar_smart_terrain_3_3"] = { -178.53926, 2.48696, 418.75180 },
    -- the mine's own mattress; Sin HQ only (warfare_player_hqs)
    ["red_smart_terrain_3_2"] = { -161.08794, 3.11622, -28.99401 },
    -- warfare_base_props' mattress; UNISG HQ only
    ["jup_b208"]              = { 384.28900, 4.40800, -130.07000 },
}

local level_spots -- positions on the current level, built on first update
local near_spot = false
local shown = false
local next_update = 0

local function create_marker(pos, gvid)
    local lvid = warfare_utils.nearest_lvid(pos)
    local se_obj = lvid and alife_create(MARKER_SECTION, pos, lvid, gvid)
    if not se_obj then
        return
    end

    local data = utils_stpk.get_space_restrictor_data(se_obj)
    data.shapes = { { shtype = 0, offset = vector():set(0, 0, 0), radius = RADIUS } }
    data.restrictor_type = NOT_A_RESTRICTOR
    utils_stpk.set_space_restrictor_data(data, se_obj)
    return se_obj.id
end

-- Creates the spot's marker if missing and makes sure it carries the map spot.
local function ensure_marker(st, smart_name, pos, gvid)
    st.warfare_sleep_markers = st.warfare_sleep_markers or {}
    local id = st.warfare_sleep_markers[smart_name]
    local se_obj = id and alife_object(id)
    if not (se_obj and se_obj:section_name() == MARKER_SECTION) then
        id = create_marker(pos, gvid)
        st.warfare_sleep_markers[smart_name] = id
        if not id then
            warfare_log.warn("warfare_sleep_spots: marker not created smart=%s", smart_name)
            return
        end
        warfare_log.info("warfare_sleep_spots: marker created smart=%s id=%s", smart_name, id)
    end
    if level.map_has_object_spot(id, MAP_SPOT) == 0 then
        level.map_add_object_spot_ser(id, MAP_SPOT, MAP_HINT)
    end
end

local function build_level_spots()
    level_spots = {}
    local st = alife_storage_manager.get_state()
    for smart_name, p in pairs(spots) do
        local smart = warfare_utils.smart_on_actor_level(smart_name)
        if smart and warfare_player_hqs.allows(smart_name) then
            local pos = vector():set(p[1], p[2], p[3])
            level_spots[#level_spots + 1] = pos
            ensure_marker(st, smart_name, pos, smart.m_game_vertex_id)
        end
    end
end

local function actor_near_spot()
    local pos = db.actor:position()
    for _, spot in ipairs(level_spots) do
        if pos:distance_to(spot) < RADIUS then
            return true
        end
    end
    return false
end

local function actor_on_update()
    local now = time_global()
    if now < next_update then
        return
    end
    next_update = now + UPDATE_MS

    if not IsWarfare() then
        return
    end
    if not level_spots then
        build_level_spots()
    end
    if #level_spots == 0 then
        return
    end

    near_spot = actor_near_spot()
    if near_spot then
        if not shown and not game.has_active_tutorial() and not has_alife_info("sleep_active") then
            shown = true
            game.start_tutorial("tutorial_sleep")
        elseif shown and not game.has_active_tutorial() then
            -- the prompt ended (used or timed out); show it again once the sleep dialog is gone
            shown = false
        end
    elseif shown then
        shown = false
        if game.has_active_tutorial() then
            game.stop_tutorial()
        end
    end
end

local base_sleep_in_zone = ui_sleep_dialog.sleep_in_zone
function ui_sleep_dialog.sleep_in_zone(actor, npc)
    if near_spot then
        give_info("sleep_active")
        ui_sleep_dialog.sleep()
        return
    end
    return base_sleep_in_zone(actor, npc)
end

local function actor_on_first_update()
    level_spots = nil
    near_spot = false
    shown = false
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
