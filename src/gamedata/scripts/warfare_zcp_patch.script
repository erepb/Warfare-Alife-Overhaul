-- Zone Customization Project (ZCP) compatibility. Inert unless ZCP is installed; supports ZCP 1.4 and 1.5.
-- Each hook is installed only when the function it wraps exists, and every ZCP hook passes through
-- to the original outside warfare games.
--
-- ZCP acts on warfare only while its own master switch (smr_enabled) is on. Then, with the
-- zcp_mutant_spawns option on, warfare's own mutant pick is handed to ZCP as the original spawn and
-- ZCP keeps or replaces it (1:1, so warfare's caps still hold), and ZCP sizes those mutant squads;
-- and ZCP's population factors are warfare's. Otherwise ZCP's species filter, variant swaps and
-- sizing are skipped for squads warfare creates, and warfare reads Anomaly's population settings.

local creating = false    -- a warfare squad is being created
local routing = false     -- ZCP is choosing a warfare mutant squad

local function zcp_enabled()
    return smr_amain_mcm.get_config("smr_enabled") and true or false
end

local function zcp_drives_mutants()
    return warfare_options.options.zcp_mutant_spawns and zcp_enabled() or false
end

local function bypass_filters()
    return creating and not zcp_drives_mutants()
end

local function is_mutant_section(section)
    local faction = ini_sys:r_string_ex(section, "faction")
    return faction and is_squad_monster[faction] or false
end

-- ZCP may size only the mutant squads warfare creates while the option is on.
local function zcp_sizes_squad(squad)
    return creating and zcp_drives_mutants() and is_mutant_section(squad:section_name())
end

-- ZCP 1.4 keeps its own check local; this mirrors it against the public enabled-prefix list.
local function type_enabled_14(section)
    for _, prefix in pairs(smr_pop.get_mutant_spawn_table()) do
        if string.sub(section, 1, string.len(prefix)) == prefix then
            return true
        end
    end
    return false
end

local function members(squad)
    local sim = alife()
    local list = {}
    for k in squad:squad_members() do
        local se_obj = k.object or k.id and sim:object(k.id)
        if se_obj then
            list[#list + 1] = se_obj
        end
    end
    return list
end

-- In warfare games ZCP's size multiplier applies only to warfare's mutant squads with the option on;
-- stalker squad sizes stay warfare's. A 1.4 shrink can release a mutant squad; checked_squad drops it.
local function patch_squad_size()
    if smr_pop.adjust_squad_size then
        local orig = smr_pop.adjust_squad_size
        smr_pop.adjust_squad_size = function(squad, smart)
            if _G.WARFARE and not zcp_sizes_squad(squad) then
                return
            end
            return orig(squad, smart)
        end
    end
    if smr_squad and smr_squad.adjust_random_count then
        local orig = smr_squad.adjust_random_count
        smr_squad.adjust_random_count = function(squad, c)
            if _G.WARFARE and not zcp_sizes_squad(squad) then
                return c
            end
            return orig(squad, c)
        end
    end
end

-- ZCP 1.4 post-processes every new squad and may release it or spawn a replacement squad. In
-- warfare games only members are removed or swapped; the squad itself is never released.
local function patch_member_filters_14()
    if smr_pop.remove_disabled_mutants_from_squad then
        local orig = smr_pop.remove_disabled_mutants_from_squad
        smr_pop.remove_disabled_mutants_from_squad = function(squad, spawn_smart)
            if not _G.WARFARE then
                return orig(squad, spawn_smart)
            end
            if bypass_filters() or not zcp_enabled() then
                return
            end
            for _, se_obj in ipairs(members(squad)) do
                if IsMonster(nil, se_obj:clsid())
                    and (not get_object_story_id(se_obj.id))
                    and (not type_enabled_14(se_obj:section_name()))
                then
                    alife_release(se_obj)
                end
            end
        end
    end

    if smr_pop.replace_mutant_variants_in_squad then
        local orig = smr_pop.replace_mutant_variants_in_squad
        smr_pop.replace_mutant_variants_in_squad = function(squad, smart)
            if not _G.WARFARE then
                return orig(squad, smart)
            end
            if bypass_filters() then
                return
            end
            local variants = smr_pop.get_unused_mutant_spawn_table()
            local chance = smr_mutants_mcm.get_config("unused_types_chance")
            for _, se_obj in ipairs(members(squad)) do
                local pool = variants[str_explode(se_obj:section_name(), "_")[1]]
                if pool and (math.random(1, 100) <= chance) then
                    local replacement = alife_create(pool[math.random(#pool)], smart)
                    if replacement then
                        squad:register_member(replacement.id)
                        alife_release(se_obj)
                    end
                end
            end
        end
    end
end

-- ZCP 1.5 filters and swaps members while the squad is being filled.
local function patch_member_filters_15()
    if not smr_squad then
        return
    end
    if smr_squad.is_mutant_type_enabled then
        local orig = smr_squad.is_mutant_type_enabled
        smr_squad.is_mutant_type_enabled = function(section)
            if bypass_filters() then
                return true
            end
            return orig(section)
        end
    end
    if smr_squad.replace_mutant_variant then
        local orig = smr_squad.replace_mutant_variant
        smr_squad.replace_mutant_variant = function(section)
            if bypass_filters() then
                return section
            end
            return orig(section)
        end
    end
end

-- In warfare games warfare's create_npc replaces ZCP 1.5's, so 1.5's member hooks run through
-- warfare's create_npc hooks instead.
local function patch_warfare_members_15()
    if not (smr_squad and smr_squad.is_mutant_type_enabled and smr_squad.replace_mutant_variant) then
        return
    end
    local orig_section = warfare_monkeypatches.squad_member_section
    warfare_monkeypatches.squad_member_section = function(squad, section)
        section = orig_section(squad, section)
        if not section then
            return nil
        end
        local faction = ini_sys:r_string_ex(squad:section_name(), "faction")
        if faction and is_squad_monster[faction] and not smr_squad.is_mutant_type_enabled(section) then
            return nil
        end
        return smr_squad.replace_mutant_variant(section)
    end

    if smr_squad.adjust_random_count then
        local orig_count = warfare_monkeypatches.squad_random_count
        warfare_monkeypatches.squad_random_count = function(squad, count)
            return smr_squad.adjust_random_count(squad, orig_count(squad, count))
        end
    end
end

-- smr_handle_spawn first rolls ZCP's zombie outbreak on any common squad, which can put a
-- zombified faction squad on a mutant lair; that roll is off while ZCP picks for warfare.
local function patch_zombie_roll()
    if not (smr_zombies_mcm and smr_zombies_mcm.get_config) then
        return
    end
    local orig = smr_zombies_mcm.get_config
    smr_zombies_mcm.get_config = function(key)
        if routing and key == "zombie_spawn" then
            return false
        end
        return orig(key)
    end
end

-- smr_handle_spawn is the one entry both ZCP versions share and the only way to reach 1.4's
-- per-level tables. It creates the squad itself; nil means the caller creates warfare's pick.
local function route_through_zcp(section, smart)
    local se_smart = smart
    if type(smart) == "string" then
        se_smart = SIMBOARD.smarts_by_names[smart]
    end
    if not se_smart then
        return nil
    end

    routing = true
    local ok, squad = pcall(smr_pop.smr_handle_spawn, section, se_smart)
    routing = false

    if not ok then
        warfare_log.err("zcp: smr_handle_spawn failed section=%s smart=%s: %s", section, se_smart:name(), squad)
        return nil
    end
    if not squad then
        return nil
    end
    if type(smart) == "string" then
        squad.scripted_target = smart
    end
    warfare_log.debug("zcp: routed section=%s -> %s smart=%s", section, squad:section_name(), se_smart:name())
    return squad
end

-- Spawn filters can leave a warfare squad without members; such a squad would never register and
-- would hold a slot in the per-level mutant cap. Dropped here, so warfare sees nil.
local function checked_squad(squad, section)
    if not squad then
        return nil
    end
    if not alife_object(squad.id) then
        warfare_log.warn("zcp: dropped released squad section=%s id=%s", section, squad.id)
        return nil
    end
    if squad:npc_count() == 0 then
        warfare_log.info("zcp: dropped empty squad section=%s id=%s", section, squad.id)
        alife_release_id(squad.id)
        return nil
    end
    return squad
end

-- ZCP's factors while it is enabled, Anomaly's otherwise (ZCP's own rule).
local function patch_pop_factors()
    local orig_stalker = warfare.get_stalker_pop_factor_value
    warfare.get_stalker_pop_factor_value = function()
        if zcp_enabled() then
            return smr_amain_mcm.get_config("stalker_pop_factor")
        end
        return orig_stalker()
    end

    local orig_monster = warfare.get_monster_pop_factor_value
    warfare.get_monster_pop_factor_value = function()
        if zcp_enabled() then
            return smr_amain_mcm.get_config("monster_pop_factor")
        end
        return orig_monster()
    end
end

local function patch_warfare_create()
    local orig = warfare.create_squad
    warfare.create_squad = function(section, smart)
        creating = true
        local squad
        if zcp_drives_mutants() and smr_pop.smr_handle_spawn and is_mutant_section(section) then
            squad = route_through_zcp(section, smart)
        end
        if not squad then
            squad = orig(section, smart)
        end
        creating = false
        return checked_squad(squad, section)
    end
end

function on_game_start()
    if not smr_pop then
        return
    end
    warfare.on_enabled(function()
        warfare_log.info("zcp: ZCP detected, installing compatibility hooks")
        patch_squad_size()
        patch_member_filters_14()
        patch_member_filters_15()
        patch_warfare_members_15()
        patch_zombie_roll()
        patch_pop_factors()
        patch_warfare_create()
    end)
end
