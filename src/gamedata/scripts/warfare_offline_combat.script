--[[

=======================================================================================
    Original creator: Tronex
    Edit log: 
    2019/09/27 - Tronex
    2020/05/27 - Vintar
    2020/05/29 - Vintar - longer connecting distance for Hybrid in story mode
    2021/02/04 - Vintar - removed Hybrid mode, re-enabled slider support for offline combat distance, changed ignore_list handling
    2021/02/13 - Vintar - fixed warfare exclusions and missing monster factions related to call of pripyat allspawn mutants
    2022/05/01 - Vintar - remove exemptions for `task_squads` and `task_giver_squads` to eliminate exempt squad buildup over time
    2022/05/21 - Vintar - remove squad cap limitation, which wasn't correctly implemented for Warfare anyway

    Offline Combat Simulator
    Full simulation: When 2 enemy squads get close to each other, a battle will be simulated
    Smart simulation: enemies assigned to the same smart terrain will fight each others

    More powerful squads have higher chance to win, power is determind by the sum of NPC ranks of the squad
    If dynamic relations are on, offline battles will anticipate in relation changes
    In addition, dominators will get more rank, and their kill stats will be recorded
=======================================================================================

    Warfare's offline combat. Vanilla sim_offline_combat.script runs in every game; in a warfare
    game install_warfare() blocks vanilla's coordinator and replaces the functions in REPLACED on
    the sim_offline_combat table. The shared tables (opponents, ocs_power, squads_by_level,
    ignore_list, story_id_communities, task_squads) are always vanilla's.

--]]

-- timer for rescanning squads and updating info [game seconds]
local UPDATE_TIME = 180
local last_coordinator_time = nil

-- When the distance between 2 enemy squads is below this value, they will fight [m^2]
local COMBAT_DISTANCE = 20 * 20

-- exclude special characters from the system and release their enemies, battles involving not_so_special communities will be ingored on the other hand
local EXCLUDE_STORY_ID = true
local EXCLUDE_STORY_ID_WARFARE = false
local NOT_SO_SPECIAL = {
    ["monster"] = true,
    ["zombied"] = true,
}

local HIT_BASE = 0.4
local HIT_FACTOR = 0.2

local RANK_FRACTION = 250
local RANK_COMMANDER_GAIN = 50

-- Time-delta combat: one round per ROUND_INTERVAL game seconds
local ROUND_INTERVAL = 180     -- 3 in-game minutes
local ROUND_CAP = 30           -- safety cap per tick

-- Skirmish gate: squads that merely cross paths roll for whether they bother to
-- engage, using the mean of both factions' patrol_hunt_chance -- each side's
-- reluctance counts, so a timid faction halves every meeting it is part of.
-- Deliberate engagements (a patrol hunt, or both squads sent at the same smart)
-- bypass the roll entirely.
-- A fight that passed the roll is a skirmish: it ends at the first death on either
-- side, and the pair gets the same recheck window a declined meeting does. The squad
-- that lost the member turns wary and declines every skirmish for SKIRMISH_WARY.
local SKIRMISH_FLOOR = 10      -- % floor; without it stalker/ecolog/zombied (all 0) never fight each other
local SKIRMISH_RECHECK = 1800  -- game seconds before a declined pair may roll again
local SKIRMISH_WARY = 10800    -- game seconds a squad avoids skirmishes after losing a member in one
local MONSTER_HUNT = 100       -- mutants always engage
local DEFAULT_HUNT = 50        -- fallback when a community has no faction options row

local can_fight_mutant
local ini_ocs
local is_enemy, math_random, math_ceil, math_max = game_relations.is_factions_enemies, math.random, math.ceil, math.max

local function distance_to_xz_sqr(a, b)
    local dx, dz = b.x - a.x, b.z - a.z
    return dx * dx + dz * dz
end

-- Shared with vanilla. task_squads is not aliased: vanilla's load_state replaces that table.
local task_giver_squads = {}

-- Background war keeps vanilla's exemption: task squads and task givers never fight offline.
local function task_exempt(id)
    return warfare.mode == "background" and (sim_offline_combat.task_squads[id] or task_giver_squads[id]) and true or false
end

-- A regular sim squad some other script spawned and drives: common, no story id, not opted out by
-- [ignore_list] (warfare's service squads are common but listed), not tied to a task.
local function is_regular(id, section)
    if get_object_story_id(id) then
        return false
    end
    local _, reason = warfare.owns_section(section)
    if reason ~= "common" then
        return false
    end
    return not (sim_offline_combat.task_squads[id] or task_giver_squads[id])
end

-- A player-controlled squad ordered against this post. Protected main bases are closed to AI
-- factions only; such a squad fights their defenders.
local function player_assault(squad, post)
    return squad ~= nil and post ~= nil and squad.assigned_target_id == post.id
        and warfare_squad_command.is_controlled(squad.id)
end
story_id_communities = sim_offline_combat.story_id_communities
ignore_list = sim_offline_combat.ignore_list
stationary_squads = {}

ocs_power = sim_offline_combat.ocs_power
opponents = sim_offline_combat.opponents
squads_by_level = sim_offline_combat.squads_by_level
-- [level_id] = { [squad_id] = true }: the squads that fight offline, rebuilt every coordinator tick.
-- squads_by_level stays warfare's own squads: faction counts, mutant caps and fog of war read it.
local combatants = {}
-- Full warfare: only combatants attack. Background war keeps vanilla's one-way story squads.
local gate_attackers = false
local faction_power = {}
local last_combat_time = {}    -- [squad_id] = CTime of last combat round
local skirmish_decline = {}    -- [pair_key] = CTime a pair declined to engage
local skirmish_incidental = {} -- [pair_key] = true while the pair's combat lock came from a passed roll
local skirmish_wary = {}       -- [squad_id] = CTime the squad lost a member in a skirmish
local power_epoch = 0          -- bumped every try_coordinator firing (UPDATE_TIME); ages out squad.wf_member_power

-- [squad_id] = x / z of an offline squad as of its own last squad_on_update (the engine moves a
-- squad in its own update, before that callback). Scans skip a pair only when this says it is out
-- of range; anything else goes through validate_enemy with live data. No entry = no skip.
local last_x, last_z = {}, {}

local tbl_smart = {}
local old_state, new_state
local opt_exclude, opt_dist = EXCLUDE_STORY_ID, COMBAT_DISTANCE

-- Species relations: the per-species [monster_relations] table the engine uses online.
local species_relations
local species_matrix              -- [from][to] = -2..1, built once from the system ini
local section_species = {}        -- [section] = species or false
local squad_species = {}          -- [squad_id] = { n = npc_count, set = { [species] = true } }, cleared each coordinator tick

local function get_species_matrix()
    if species_matrix then
        return species_matrix
    end
    species_matrix = {}
    local columns = {}
    local list = ini_sys:r_string_ex("monster_communities", "communities")
    if list then
        local parts = str_explode(list, ",")
        for i = 1, #parts, 2 do
            columns[#columns + 1] = parts[i]
        end
    end
    local rows = 0
    for _, from in ipairs(columns) do
        local row = ini_sys:r_string_ex("monster_relations", from)
        if row then
            local values = str_explode(row, ",")
            local rel = {}
            for i, to in ipairs(columns) do
                rel[to] = tonumber(values[i])
            end
            species_matrix[from] = rel
            rows = rows + 1
        end
    end
    local function show(a, b)
        return species_matrix[a] and species_matrix[a][b]
    end
    warfare_log.debug("ocs: species matrix built columns=%s rows=%s human->zombie=%s zombie->human=%s human->dog=%s",
        #columns, rows, show("human", "zombie"), show("zombie", "human"), show("human", "dog"))
    return species_matrix
end

local function member_species(section)
    local species = section_species[section]
    if species == nil then
        species = ini_sys:r_string_ex(section, "species") or false
        section_species[section] = species
    end
    return species
end

local function get_squad_species(squad)
    local n = squad:npc_count()
    local cached = squad_species[squad.id]
    if cached and cached.n == n then
        return cached.set
    end
    local set = {}
    local sim = alife()
    for k in squad:squad_members() do
        local se_obj = k.object or k.id and sim:object(k.id)
        local species = se_obj and member_species(se_obj:section_name())
        if species then
            set[species] = true
        end
    end
    squad_species[squad.id] = { n = n, set = set }
    return set
end

-- true if any member species of one squad is hostile to any of the other's, in either direction;
-- false if every checked pair is known and none is hostile; nil if no pair could be resolved.
local function species_hostile(squad_1, squad_2)
    local matrix = get_species_matrix()
    local known = false
    for a in pairs(get_squad_species(squad_1)) do
        for b in pairs(get_squad_species(squad_2)) do
            local ab = matrix[a] and matrix[a][b]
            local ba = matrix[b] and matrix[b][a]
            if (ab and ab < 0) or (ba and ba < 0) then
                return true
            end
            if ab and ba then
                known = true
            end
        end
    end
    if known then
        return false
    end
    return nil
end

-- In warfare games mutant-vs-people pairs follow species relations, as they do online; everything
-- else, and any pair the species table cannot resolve, follows community relations.
local function pair_hostile(squad_1, community_1, squad_2, community_2)
    if species_relations and ((community_1 == "monster") ~= (community_2 == "monster")) then
        local hostile = species_hostile(squad_1, squad_2)
        if hostile ~= nil then
            return hostile
        end
    end
    return is_enemy(community_1, community_2)
end

-- Mutants settings
local m_rank_max, m_rank_factor = 27000, 0.2
local m_class = {
    [clsid.rat_s] = 0.01,
    [clsid.tushkano_s] = 0.05,

    [clsid.zombie_s] = 0.1,
    [clsid.cat_s] = 0.2,
    [clsid.dog_s] = 0.1,
    [clsid.flesh_s] = 0.1,
    [clsid.boar_s] = 0.25,

    [clsid.fracture_s] = 0.4,
    [clsid.snork_s] = 0.4,
    [clsid.pseudodog_s] = 0.35,

    [clsid.bloodsucker_s] = 0.5,
    [clsid.poltergeist_s] = 0.6,

    [clsid.psy_dog_phantom_s] = 0.5,
    [clsid.psy_dog_s] = 0.5,
    [clsid.burer_s] = 0.65,
    [clsid.controller_s] = 0.7,

    [clsid.chimera_s] = 1.3,
    [clsid.gigant_s] = 1.5,
}


-------------------------------
-- Main
-------------------------------
local function smart_terrain_on_update(smart)
    if warfare_log.tracing() then
        warfare_log.trace("smart_terrain_on_update: smart=%s id=%s", smart.name and smart:name() or "?", smart.id)
    end

    empty_table(tbl_smart)

    for id, _ in pairs(SIMBOARD.smarts[smart.id].squads) do
        tbl_smart[#tbl_smart + 1] = id
    end

    if (#tbl_smart == 0) then
        warfare_log.trace("smart_terrain_on_update: no squads, smart=%s", smart.id)
        return
    end

    shuffle_table(tbl_smart)

    local sim = alife()
    local lid_1

    for i, id_1 in pairs(tbl_smart) do
        local squad_1 = sim:object(id_1)
        local section = squad_1 and squad_1:section_name()

        if squad_1 and (not squad_1.online) and SIMBOARD.squads[squad_1.id] and (squad_1:npc_count() > 0)
        and not axr_companions.companion_squads[id_1]
        then
            local community_1 = squad_1:get_squad_community()
            if (community_1 == "monster" and (not can_fight_mutant)) then
                warfare_log.trace("smart_terrain_on_update: skip monster (can_fight_mutant=off) squad=%s", id_1)
                goto next_squad
            end

            lid_1 = lid_1 or game_graph():vertex(squad_1.m_game_vertex_id):level_id()
            local fighters = lid_1 and combatants[lid_1]
            if fighters and ((not gate_attackers) or fighters[id_1]) then

                --                if (not task_squads[id_1]) and (not task_giver_squads[id_1]) then
                -- disable offline combat for ignore list when Warfare is active
                if not warfare.sim or (warfare.sim and not ignore_list[section]) then
                    -- If squad already have an opponent, no need for full scan
                    local id_t = opponents[id_1]
                    if id_t and fighters[id_t] then
                        --squad_1.assigned_target_id = id_t
                        warfare_log.trace("smart_terrain_on_update: existing opponent squad=%s target=%s", id_1, id_t)
                        in_combat = validate_enemy(sim, lid_1, squad_1, id_1, id_t, community_1)
                        if in_combat then
                            return
                        end
                        local sq_t = sim:object(id_t)
                        local _dist_sqr = sq_t and distance_to_xz_sqr(squad_1.position, sq_t.position)
                        if sq_t and _dist_sqr and _dist_sqr > opt_dist then
                            warfare_log.debug("smart_terrain_on_update: out of range disengage squad=%s target=%s dist_sqr=%s opt_dist=%s", id_1, id_t, _dist_sqr, opt_dist)
                            disengage_combat(id_1, squad_1, id_t, sq_t)
                        end
                    elseif id_t then
                        local sq_t = sim:object(id_t)
                        warfare_log.debug("smart_terrain_on_update: stale opponent (gone from level) squad=%s target=%s", id_1, id_t)
                        disengage_combat(id_1, squad_1, id_t, sq_t)
                    end

                    -- Otherwise, scan the squads at this smart. last_x is only kept by the full-mode
                    -- squad_on_update, so validate_enemy checks the distance with live positions.
                    local pos_1 = squad_1.position
                    for j, id_2 in pairs(tbl_smart) do
                        if (not gate_attackers) or fighters[id_2] then
                            in_combat = validate_enemy(sim, lid_1, squad_1, id_1, id_2, community_1, pos_1)
                            if in_combat then
                                return
                            end
                        end
                    end
                end
                --                end
            end
        end
        ::next_squad::
    end
end

local function squad_on_update(squad_1)
    if warfare_log.tracing() then
        warfare_log.trace("ocs.squad_on_update: squad=%s", squad_1 and squad_1:name() or "?")
    end

    if (squad_1:clsid() ~= clsid.online_offline_group_s) then
        warfare_log.err("!!! TRYING TO REGISTER NON-SQUAD AS SQUAD: squad=%s", squad_1 and squad_1:name() or "?")
        printe("!!! TRYING TO REGISTER NON-SQUAD AS SQUAD")
        return
    end

    local id_1 = squad_1.id
    if (squad_1.online) then
        last_x[id_1], last_z[id_1] = nil, nil
        return
    end
    local pos_1 = squad_1.position
    local x1, z1 = pos_1.x, pos_1.z
    last_x[id_1], last_z[id_1] = x1, z1

    -- Make sure squad exists within the simboard, and npc counts are greater than 0
    if not (SIMBOARD.squads[id_1] and (squad_1:npc_count() > 0)) or axr_companions.companion_squads[id_1] then
        return
    end

    local sim = alife()
    local community_1 = squad_1:get_squad_community()
    local lid_1 = game_graph():vertex(squad_1.m_game_vertex_id):level_id()
    local in_combat
    local section = squad_1 and squad_1:section_name()

    if (community_1 == "monster" and (not can_fight_mutant)) then
        warfare_log.trace("ocs.squad_on_update: skip monster (can_fight_mutant=off) squad=%s", id_1)
        return
    end

    -- Scan all squads in related level
    -- Only simulate in same level and enough squads num cap
    local fighters = lid_1 and combatants[lid_1]
    if fighters and ((not gate_attackers) or fighters[id_1]) then

        -- Only simulate for non-task squads
        --        if (not task_squads[id_1]) and (not task_giver_squads[id_1]) then
        -- disable offline combat for ignore list when Warfare is active
        if not warfare.sim or (warfare.sim and not ignore_list[section]) then
            -- If squad already have an opponent, no need for full scan
            local id_t = opponents[id_1]
            if id_t and fighters[id_t] then
                --squad_1.assigned_target_id = id_t
                warfare_log.trace("ocs.squad_on_update: existing opponent squad=%s target=%s", id_1, id_t)
                in_combat = validate_enemy(sim, lid_1, squad_1, id_1, id_t, community_1)
                if in_combat then
                    return
                end
                local sq_t = sim:object(id_t)
                local _dist_sqr = sq_t and distance_to_xz_sqr(squad_1.position, sq_t.position)
                if sq_t and _dist_sqr and _dist_sqr > opt_dist then
                    warfare_log.debug("ocs.squad_on_update: out of range disengage squad=%s target=%s dist_sqr=%s opt_dist=%s", id_1, id_t, _dist_sqr, opt_dist)
                    disengage_combat(id_1, squad_1, id_t, sq_t)
                end
            elseif id_t then
                -- Opponent left level, died, or was removed: clear stale combat lock
                warfare_log.debug("ocs.squad_on_update: stale opponent (left level/died) squad=%s target=%s", id_1, id_t)
                local sq_t = sim:object(id_t)
                disengage_combat(id_1, squad_1, id_t, sq_t)
            end

            -- Otherwise, scan for squads in the same map
            -- No last_x: online (validate_enemy rejects it) or not yet updated (picked up once it has).
            for id_2, _ in pairs(fighters) do
                local x2 = last_x[id_2]
                if x2 then
                    local dx, dz = x2 - x1, last_z[id_2] - z1
                    if (dx * dx + dz * dz < opt_dist) then
                        in_combat = validate_enemy(sim, lid_1, squad_1, id_1, id_2, community_1, pos_1)
                        if in_combat then
                            return
                        end
                    end
                end
            end
        end
        --        end
    end
end

-------------------------------
-- Distance-based combat functions
-------------------------------

-- Exponential decay curve per smart kind: y = span * e^(k * d/max_distance) + min_multiplier,
-- reaching min_multiplier at max_distance. span and k depend only on the options, so they are
-- built once per call instead of once per owned smart.
local function make_curve(global_max_distance, max_mult, min_multiplier)
    local span = max_mult - min_multiplier
    return {
        max_distance = global_max_distance * max_mult,
        span = span,
        k = math.log(0.01 / span),
    }
end

local function build_curves(opts, min_multiplier)
    local d = opts.distance_combat_max_distance
    return {
        base      = make_curve(d, opts.distance_combat_max_multiplier_base, min_multiplier),
        resource  = make_curve(d, opts.distance_combat_max_multiplier_resource, min_multiplier),
        territory = make_curve(d, opts.distance_combat_max_multiplier_territory, min_multiplier),
        lair      = make_curve(d, opts.distance_combat_max_multiplier_lair, min_multiplier),
        other     = make_curve(d, 1, min_multiplier),
    }
end

-- best_multiplier for faction F depends only on smarts F owns, so invalidation is per faction:
-- a capture bumps exactly two epochs and leaves every other faction's cache valid. epoch_base
-- only ever rises, so a faction's epoch is strictly increasing and can never repeat a value.
local epoch_base = 0
local owner_epoch = {}     -- [faction] = own bumps
local owned_ids = {}       -- [faction] = { smart id, ... }
local owned_built_at = {}  -- [faction] = epoch the list was built at

local function faction_epoch(faction)
    return epoch_base + (owner_epoch[faction] or 0)
end

-- Called from smart_terrain_warfare on every owner change: bootstrap_smart and check_owner.
function on_smart_owner_changed(old_faction, new_faction)
    if old_faction then
        owner_epoch[old_faction] = (owner_epoch[old_faction] or 0) + 1
    end
    if new_faction then
        owner_epoch[new_faction] = (owner_epoch[new_faction] or 0) + 1
    end
end

-- The smarts warfare_levels.supported_smarts() yields, resolved once. Dropped with the distance
-- cache, which every options change (the level filter included), every load and the end of
-- level admission (warfare's one-shot init) go through.
local supported_objs = nil

-- Drops every faction's cache at once. Needed on an options change (which smarts count, and the
-- curve shape, both move) and on load (a faction that owned smarts last session may own none now).
function invalidate_distance_cache()
    epoch_base = epoch_base + 1
    supported_objs = nil
end

local function get_supported_objs()
    if not supported_objs then
        supported_objs = {}
        for name,smart in warfare_levels.supported_smarts() do
            if smart then
                supported_objs[#supported_objs + 1] = smart
            end
        end
    end
    return supported_objs
end

-- The all-smarts scan runs once per faction epoch instead of once per call.
local function owned_smart_ids(faction)
    local epoch = faction_epoch(faction)
    if owned_built_at[faction] == epoch then
        return owned_ids[faction]
    end

    local ids = {}
    local n = 0
    local smarts = get_supported_objs()
    for i = 1, #smarts do
        local smart = smarts[i]
        if smart.owning_faction == faction then
            n = n + 1
            ids[n] = smart.id
        end
    end

    owned_ids[faction] = ids
    owned_built_at[faction] = epoch
    warfare_log.trace("owned_smart_ids: rebuilt faction=%s count=%s epoch=%s", tostring(faction), n, epoch)
    return ids
end

local function curve_for(curves, props)
    return curves[warfare_utils.smart_kind(props) or "other"]
end

function calculate_distance_combat_multiplier(pos, community)
    warfare_log.trace("calculate_distance_combat_multiplier: community=%s", community)
    if not warfare.sim then
        return 1.0 -- No modification if warfare is not active
    end

    local opts = warfare_options.options
    if not opts.distance_based_combat_multiplier then
        return 1.0 -- No modification if feature is disabled
    end

    if not (pos) then
        warfare_log.warn("calculate_distance_combat_multiplier: nil pos for community=%s, skipping distance multiplier", tostring(community))
        return 1.0
    end

    local min_multiplier = opts.distance_combat_min_multiplier
    local curves = build_curves(opts, min_multiplier)

    local best_multiplier = 0
    local px, pz = pos.x, pos.z

    -- Only the smarts this faction owns, from the epoch-keyed index
    local ids = owned_smart_ids(community)
    for i = 1, #ids do
        local smart = alife_object(ids[i])
        local props = smart and smart.props
        -- Smarts do not move, and from() writes the field as a side effect (nil is warned once).
        local smart_pos = props and (smart.global_position or global_position.from(smart))

        if smart_pos then
            local dx, dz = px - smart_pos.x, pz - smart_pos.z
            local distance = math.sqrt(math.max(1, dx * dx + dz * dz))
            local curve = curve_for(curves, props)

            -- Only smarts within range contribute.
            if distance < curve.max_distance then
                local multiplier = curve.span * math.exp(curve.k * (distance / curve.max_distance)) + min_multiplier

                if multiplier > best_multiplier then
                    best_multiplier = multiplier
                end
            end
        end
    end

    warfare_log.trace("calculate_distance_combat_multiplier: community=%s best=%s", community, best_multiplier)
    return best_multiplier > 0 and best_multiplier or 1.0
end

-- Memoized squad path. The record lives on the squad's Lua wrapper beside global_position, so it
-- is freed with the object: no id-keyed table, no purge hook, nothing saved.
-- community stays in the key because calculate_npc_power passes an explicit one that need not be
-- the squad's own.
local function calculate_squad_distance_multiplier(squad, community)
    if not squad then
        return 1
    end

    community = community or squad:get_squad_community()
    if not community then
        return 1
    end

    local gvid = squad.m_game_vertex_id
    local epoch = faction_epoch(community)
    local rec = squad.wf_power

    if rec and rec.gvid == gvid and rec.community == community and rec.epoch == epoch then
        return rec.mult
    end

    local mult = calculate_distance_combat_multiplier(global_position.from(squad), community)
    squad.wf_power = { gvid = gvid, community = community, epoch = epoch, mult = mult }
    return mult
end

local function coordinator()
    warfare_log.debug("coordinator: tick start old_state=%s mode=%s", old_state, warfare.mode)

    -- Toggle feature


    if (ui_options.get("alife/general/offline_combat") == "on_smarts_only") then
        new_state = 2
    elseif (ui_options.get("alife/general/offline_combat") == "full") then
        new_state = 1
    else
        if (old_state == 1) then
            warfare_log.info("coordinator: offline_combat disabled; unregister squad_on_update")
            UnregisterScriptCallback("squad_on_update", squad_on_update)
        elseif (old_state == 2) then
            warfare_log.info("coordinator: offline_combat disabled; unregister smart_terrain_on_update")
            UnregisterScriptCallback("smart_terrain_on_update", smart_terrain_on_update)
        end
        old_state = 0
        new_state = 0
        return
    end

    if (old_state ~= new_state) then

        -- On smart only
        if (new_state == 2) then
            if (old_state == 1) then
                UnregisterScriptCallback("squad_on_update", squad_on_update)
            end
            old_state = 2
            warfare_log.info("coordinator: register smart_terrain_on_update (smart-only mode)")
            RegisterScriptCallback("smart_terrain_on_update", smart_terrain_on_update)

            -- Full
        elseif (new_state == 1) then
            if (old_state == 2) then
                UnregisterScriptCallback("smart_terrain_on_update", smart_terrain_on_update)
            end
            old_state = 1
            warfare_log.info("coordinator: register squad_on_update (full mode)")
            RegisterScriptCallback("squad_on_update", squad_on_update)
        end
    end

    -- Empty tables, prepare
    local sim = alife()
    local gg = game_graph()
    empty_table(squads_by_level)

    for id in pairs(last_x) do
        if not (SIMBOARD.squads[id]) then
            last_x[id], last_z[id] = nil, nil
        end
    end

    -- Get rid of non-existing task squads cache
    local task_squads = sim_offline_combat.task_squads
    for id, v in pairs(task_squads) do
        local squad = sim:object(id)
        if (not squad) then
            task_squads[id] = nil
        end
    end

    -- Exclude task givers squads from simulation
    empty_table(task_giver_squads)
    for k, tsk in pairs(task_manager.get_task_manager().task_info) do
        local id = tsk.task_giver_id
        local se_npc = id and sim:object(id)
        local squad = se_npc and se_npc.group_id and se_npc.group_id ~= 65535 and sim:object(se_npc.group_id)
        if squad then
            task_giver_squads[squad.id] = true
        end
    end

    -- squads_by_level: warfare's own squads. combatants: who fights offline -- warfare's own squads
    -- and other scripts' regular squads, never companions.
    empty_table(combatants)
    local n_owned, n_fighting = 0, 0
    for id, _ in pairs(SIMBOARD.squads) do
        local squad = sim:object(id)
        local section = squad and squad:section_name()
        if squad and section then
            local owned, fights
            if warfare.sim then
                owned = warfare.is_owned(squad)
                fights = owned or is_regular(id, section)
            else
                owned = (not get_object_story_id(id)) and ini_sys:r_bool_ex(section, "common")
                fights = owned
            end
            fights = fights and not axr_companions.companion_squads[id]
            if owned or fights then
                local lid = gg:vertex(squad.m_game_vertex_id):level_id()
                if owned then
                    squads_by_level[lid] = squads_by_level[lid] or {}
                    squads_by_level[lid][id] = true
                    n_owned = n_owned + 1
                end
                if fights then
                    combatants[lid] = combatants[lid] or {}
                    combatants[lid][id] = true
                    n_fighting = n_fighting + 1
                end
            end
        end
    end

    local stalker_pop_factor = warfare.get_stalker_pop_factor()
    local monster_pop_factor = warfare.get_monster_pop_factor()
    local pop_factor = (stalker_pop_factor + monster_pop_factor) / 2

    -- Options by mode
    if warfare.sim then
        opt_dist = math.pow(ui_options.get("alife/warfare/general/offline_combat_distance") or 50, 2)
        -- background war keeps vanilla's story-squad protection
        if _G.WARFARE then
            opt_exclude = EXCLUDE_STORY_ID_WARFARE
            gate_attackers = true
        else
            opt_exclude = EXCLUDE_STORY_ID
            gate_attackers = false
        end
        can_fight_mutant = warfare_options.options.enable_mutant_offline_combat
        species_relations = true

        for community, v in pairs(warfare_options.options.factions) do
            faction_power[community] = v.offline_power_multiplier
        end
    else
        opt_dist = COMBAT_DISTANCE
        opt_exclude = EXCLUDE_STORY_ID
        gate_attackers = false
        can_fight_mutant = true
        species_relations = false
    end

    purge_expired_skirmishes()
    empty_table(squad_species)

    warfare_log.debug("coordinator: tick done opt_dist=%s can_fight_mutant=%s pop_factor=%s registered=%s combatants=%s gate_attackers=%s",
        opt_dist, can_fight_mutant and "y" or "n", pop_factor, n_owned, n_fighting, gate_attackers and "y" or "n")

    --[[ Debugger
    if warfare_log.enabled() and (not _G.WARFARE) then
        for lid,v in pairs(squads_by_level) do
            local clr = limit_by_level[lid] and "%" or "~"
        end
    end
    --]]
end

function try_coordinator()
    if not last_coordinator_time then
        warfare_log.debug("try_coordinator: first tick, running coordinator")
        last_coordinator_time = warfare.get_time()
        power_epoch = power_epoch + 1
        coordinator()
        return
    end
    local elapsed = warfare.get_time_ref():diffSec(last_coordinator_time)
    if elapsed >= UPDATE_TIME then
        warfare_log.trace("try_coordinator: firing coordinator elapsed=%s update_time=%s", elapsed, UPDATE_TIME)
        last_coordinator_time = warfare.get_time()
        power_epoch = power_epoch + 1
        coordinator()
    end
end

-- True when the squad's group flag reports online, or any member server object
-- is already (or in the middle of) switching online. The engine sets m_bOnline
-- before it net-spawns each member, so a mid-switch member reads online here.
-- Running the offline death path (on_death/remove_squad) on such a squad desyncs
-- the alife switch manager and crashes on the next net_spawn ("Object with ID
-- already exists"). Used to defer offline combat until the switch settles.
local function squad_is_switching_online(squad)
    if not squad then
        return false
    end
    if squad.online then
        return true
    end
    local sim = alife()
    for k in squad:squad_members() do
        local se = k.id and k.id ~= 65535 and sim:object(k.id)
        if se and se.online then
            return true
        end
    end
    return false
end

-- Order-independent key: validate_enemy sees the same pair in both orders on
-- different ticks, so the decision has to be stored once for the pair.
local function skirmish_pair_key(id_1, id_2)
    if id_1 < id_2 then
        return id_1 * 65536 + id_2
    end
    return id_2 * 65536 + id_1
end

local function skirmish_hunt_chance(community)
    if community == "monster" then
        return MONSTER_HUNT
    end
    local factions = warfare_options and warfare_options.options and warfare_options.options.factions
    local opts = factions and factions[community]
    return (opts and opts.patrol_hunt_chance) or DEFAULT_HUNT
end

local function is_wary(id, now)
    local t = skirmish_wary[id]
    return t and now:diffSec(t) < SKIRMISH_WARY
end

-- Decides whether two squads that have found each other actually fight.
-- Only incidental meetings roll; anything deliberate resolves as before.
local function should_skirmish(squad_1, squad_2, id_1, id_2, community_1, community_2)
    -- Already locked to each other: the fight is underway, never re-roll it.
    if opponents[id_1] == id_2 then
        return true
    end

    -- Deliberate: one squad was sent at the other (patrol hunt), or both were
    -- sent at the same smart (assault vs its garrison, or a contested objective).
    local key = skirmish_pair_key(id_1, id_2)
    local t1, t2 = squad_1.assigned_target_id, squad_2.assigned_target_id
    if (t1 == id_2) or (t2 == id_1) or (t1 and t1 == t2) then
        skirmish_incidental[key] = nil
        return true
    end

    local now = warfare.get_time_ref()
    local declined = skirmish_decline[key]
    if declined and now:diffSec(declined) < SKIRMISH_RECHECK then
        return false
    end

    -- A squad still smarting from a skirmish loss waves everyone through.
    local wary = (is_wary(id_1, now) and id_1) or (is_wary(id_2, now) and id_2)
    if wary then
        skirmish_decline[key] = warfare.get_time()
        warfare_log.debug("validate_enemy: skirmish avoided squad_1=%s squad_2=%s wary=%s", id_1, id_2, wary)
        return false
    end

    local a = skirmish_hunt_chance(community_1)
    local b = skirmish_hunt_chance(community_2)
    local chance = (a + b) / 2
    if chance < SKIRMISH_FLOOR then
        chance = SKIRMISH_FLOOR
    end

    if math_random(100) > chance then
        skirmish_decline[key] = warfare.get_time()
        warfare_log.debug("validate_enemy: skirmish declined squad_1=%s squad_2=%s community_1=%s community_2=%s chance=%s",
            id_1, id_2, community_1, community_2, chance)
        return false
    end

    skirmish_decline[key] = nil
    skirmish_incidental[key] = true
    return true
end

-- Ends a skirmish after its one death: unlock both squads, wave the pair off for
-- SKIRMISH_RECHECK so they walk away instead of re-engaging next tick, and make the
-- loser wary.
local function skirmish_break_off(id_1, squad_1, id_2, squad_2, se_victim, round)
    warfare_log.debug("simulate_battle: skirmish break-off attacker=%s victim=%s after npc=%s round=%s", id_1, id_2, se_victim and se_victim.id or "?", round)
    skirmish_decline[skirmish_pair_key(id_1, id_2)] = warfare.get_time()
    skirmish_wary[id_2] = warfare.get_time()
    disengage_combat(id_1, squad_1, id_2, squad_2)
end

-- Drops declines and wary marks that have aged out. Entries are keyed by squad
-- pair / squad id, and squad ids get recycled, so they must not be allowed to sit
-- around indefinitely.
function purge_expired_skirmishes()
    local now = warfare.get_time_ref()
    for key, t in pairs(skirmish_decline) do
        if now:diffSec(t) >= SKIRMISH_RECHECK then
            skirmish_decline[key] = nil
        end
    end
    for id, t in pairs(skirmish_wary) do
        if now:diffSec(t) >= SKIRMISH_WARY then
            skirmish_wary[id] = nil
        end
    end
end

function validate_enemy(sim, lid, squad_1, id_1, id_2, community_1, pos_1)
    if (id_2 == id_1) then
        return false
    end

    if task_exempt(id_1) or task_exempt(id_2) or axr_companions.companion_squads[id_2] then
        return false
    end

    -- target is not occupied
    local occupied_by = opponents[id_2]
    if (occupied_by ~= nil) and (occupied_by ~= id_1) then
        return false
    end

    if (not sim) then
        sim = alife()
    end

    local squad_2 = id_2 and sim:object(id_2)
    if (not squad_2) or squad_2.online then
        return false
    end

    -- Only simulate for close squads
    local p1, p2 = pos_1 or squad_1.position, squad_2.position
    local dx, dz = p2.x - p1.x, p2.z - p1.z
    local dist_sqr = dx * dx + dz * dz
    if (dist_sqr >= opt_dist) then
        return false
    end

    if warfare.sim and ignore_list[squad_2:section_name()] then
        return false
    end

    -- Only simulate for enemies
    local community_2 = squad_2:get_squad_community()
    if not ((community_2 ~= "monster" or can_fight_mutant) and pair_hostile(squad_1, community_1, squad_2, community_2)) then
        return false
    end

    if warfare_log.tracing() then
        warfare_log.trace("validate_enemy: id_1=%s id_2=%s lid=%s community=%s", id_1, id_2, lid, community_1)
    end

    if opt_exclude then
        -- warfare's own squads fight like common ones, whatever their section's common flag
        local sid_1 = not squad_1.common and not warfare.is_owned(squad_1)
        local sid_2 = not squad_2.common and not warfare.is_owned(squad_2)

        -- If both are story squads, don't simulate battle
        if sid_1 and sid_2 then
            warfare_log.debug("validate_enemy: both story squads, skip id_1=%s id_2=%s", id_1, id_2)
            return false

            -- If one is a story squad, kill the other squads incase they have the same target
        elseif (sid_1 or sid_2) and (squad_1.assigned_target_id == squad_2.assigned_target_id) then

            if (sid_1 and NOT_SO_SPECIAL[community_1]) then

            elseif (sid_2 and NOT_SO_SPECIAL[community_2]) then

            elseif sid_1 then
                if squad_is_switching_online(squad_2) then
                    warfare_log.debug("validate_enemy: victim squad_2=%s switching online, skip story kill", id_2)
                else
                    warfare_log.debug("validate_enemy: story squad_1=%s kills non-story squad_2=%s (shared target)", id_1, id_2)
                    remove_squad_info(squad_2, id_2, id_1, lid)
                    local se_attacker = get_random_npc(squad_1)
                    local member_ids = {}
                    for k in squad_2:squad_members() do
                        member_ids[#member_ids + 1] = k.id
                    end
                    for i = 1, #member_ids do
                        local victim = alife_object(member_ids[i])
                        if victim then
                            victim:on_death(se_attacker)
                        end
                    end
                end

            elseif sid_2 then
                if squad_is_switching_online(squad_1) then
                    warfare_log.debug("validate_enemy: victim squad_1=%s switching online, skip story kill", id_1)
                else
                    warfare_log.debug("validate_enemy: story squad_2=%s kills non-story squad_1=%s (shared target)", id_2, id_1)
                    remove_squad_info(squad_1, id_1, id_2, lid)
                    local se_attacker = get_random_npc(squad_2)
                    local member_ids = {}
                    for k in squad_1:squad_members() do
                        member_ids[#member_ids + 1] = k.id
                    end
                    for i = 1, #member_ids do
                        local victim = alife_object(member_ids[i])
                        if victim then
                            victim:on_death(se_attacker)
                        end
                    end
                end
            end

            return false
        end
    end

    -- Skip offline combat when one side is a defender at a protected main base
    -- that STILL belongs to its original faction. The warfare targeting layer
    -- already prevents squads from attacking main bases, so any nearby enemy
    -- is just passing through, not attacking.
    -- Only protect when the main base is held by its original faction.
    -- If another faction captured it, combat should proceed normally.
    -- A player assault on the base is fought regardless.
    if warfare.sim and warfare_options and warfare_options.options.prevent_mainbase_attacks then
        local sm1 = squad_1.assigned_target_id and alife_object(squad_1.assigned_target_id)
        if sm1 and sm1.owning_faction == community_1 and not player_assault(squad_2, sm1) then
            local sm1_name = sm1.name and sm1:name()
            local original_faction_1 = sm1_name and smart_terrain_warfare.get_protected_base_faction(sm1_name)
            if sm1_name and original_faction_1 and original_faction_1 == community_1 then
                warfare_log.debug("validate_enemy: skip protected mainbase squad_1=%s target=%s faction=%s", id_1, sm1_name, community_1)
                return false
            end
        end
        local sm2 = squad_2.assigned_target_id and alife_object(squad_2.assigned_target_id)
        if sm2 and sm2.owning_faction == community_2 and not player_assault(squad_1, sm2) then
            local sm2_name = sm2.name and sm2:name()
            local original_faction_2 = sm2_name and smart_terrain_warfare.get_protected_base_faction(sm2_name)
            if sm2_name and original_faction_2 and original_faction_2 == community_2 then
                warfare_log.debug("validate_enemy: skip protected mainbase squad_2=%s target=%s faction=%s", id_2, sm2_name, community_2)
                return false
            end
        end
    end

    -- Two squads crossing paths only fight if one of them is willing.
    -- Returning false (rather than true) leaves both unlocked and lets
    -- the caller keep scanning, so a squad that waves this one through
    -- can still engage somebody else on the same tick.
    if not should_skirmish(squad_1, squad_2, id_1, id_2, community_1, community_2) then
        return false
    end

    -- Calculate combat rounds from time delta
    local now = warfare.get_time_ref()
    local rounds = 1
    local last_t = last_combat_time[id_1]
    if last_t then
        local elapsed = now:diffSec(last_t)
        if elapsed < ROUND_INTERVAL then
            -- Not enough time for a round yet, stay locked in combat
            return true
        end
        rounds = math.floor(elapsed / ROUND_INTERVAL)
        if rounds > ROUND_CAP then
            warfare_log.warn("!OCS round cap hit: %s vs %s rounds=%s capped=%s elapsed=%s", squad_1:name(), squad_2:name(), rounds, ROUND_CAP, elapsed)
            rounds = ROUND_CAP
        end
    end
    last_combat_time[id_1] = warfare.get_time()

    -- Simulate battle
    warfare_log.debug("validate_enemy: engage squad_1=%s squad_2=%s dist_sqr=%s rounds=%s", id_1, id_2, dist_sqr, rounds)
    simulate_battle(id_1, id_2, squad_1, squad_2, community_1, community_2, lid, rounds)

    return true
end

function simulate_battle(id_1, id_2, squad_1, squad_2, community_1, community_2, lid, rounds)
    --squad 1 = Attacker
    -- squad 2 = Victim
    rounds = rounds or 1
    warfare_log.debug("simulate_battle: attacker=%s victim=%s community_1=%s community_2=%s rounds=%s", id_1, id_2, community_1, community_2, rounds)

    -- Never run the offline death path on a squad the engine is switching online.
    -- Online state cannot change within this call (no yields), so one check up
    -- front covers every on_death below. Defer combat so it retries once the
    -- switch settles, instead of corrupting the switch manager (duplicate net_spawn).
    if squad_is_switching_online(squad_2) then
        warfare_log.debug("simulate_battle: victim squad=%s switching online, defer combat", id_2)
        disengage_combat(id_1, squad_1, id_2, squad_2)
        return
    end

    -- Get squad power
    ocs_power[id_1] = calculate_squad_power(squad_1, community_1)
    ocs_power[id_2] = calculate_squad_power(squad_2, community_2)

    local pair_key = skirmish_pair_key(id_1, id_2)
    if not (ocs_power[id_1] > 0 and ocs_power[id_2] > 0) then
        warfare_log.debug("simulate_battle: zero power, skip attacker=%s pow=%s victim=%s pow=%s", id_1, ocs_power[id_1], id_2, ocs_power[id_2])
        skirmish_incidental[pair_key] = nil
        return
    end

    -- Make both squads targeting themselves
    opponents[id_1] = id_2
    --squad_1.assigned_target_id = id_2

    opponents[id_2] = id_1
    --squad_2.assigned_target_id = id_1

    -- A skirmish costs at most one life: a blow that would wipe a multi-member squad is
    -- downgraded to a single kill, and the first kill ends the fight.
    local skirmish = skirmish_incidental[pair_key]

    for round = 1, rounds do
        -- Get squads MVPs (re-pick each round, NPCs may die between rounds)
        local se_attacker = get_random_npc(squad_1)
        local se_victim = get_random_npc(squad_2)
        if not se_attacker or not se_victim then
            warfare_log.warn("simulate_battle: missing combatant, disengage attacker_id=%s victim_id=%s round=%s", id_1, id_2, round)
            disengage_combat(id_1, squad_1, id_2, squad_2)
            return
        end

        -- Calculate damage dealt
        local raw_power = calculate_squad_power(squad_2, community_2, true)
        local damage = ocs_power[id_1] * (HIT_BASE + math_random() * HIT_FACTOR)
        damage = math_ceil(damage)


        -- Cause damage
        ocs_power[id_2] = ocs_power[id_2] - damage
        warfare_log.trace("simulate_battle: round=%s attacker=%s pow=%s -> victim=%s dmg=%s remaining=%s", round, id_1, ocs_power[id_1], id_2, damage, ocs_power[id_2])

        local wiped = ocs_power[id_2] <= 0

        -- Release victim squad if it got rekt
        if wiped and not (skirmish and squad_2:npc_count() > 1) then

            -- Post-battle state
            warfare_log.debug("simulate_battle: VICTORY attacker=%s wiped victim=%s round=%s damage=%s", id_1, id_2, round, damage)
            set_battle_outcome(true, id_1, id_2, squad_1, squad_2, community_1, community_2, se_attacker, se_victim, damage)

            -- Release: collect member IDs first to avoid iterator invalidation
            -- on_death -> squad:on_npc_death -> remove_npc -> unregister_member modifies m_members
            remove_squad_info(squad_2, id_2, id_1, lid)
            local member_ids = {}
            for k in squad_2:squad_members() do
                member_ids[#member_ids + 1] = k.id
            end
            for i = 1, #member_ids do
                local mid = member_ids[i]
                local victim = mid and mid ~= 65535 and alife_object(mid)
                if victim then
                    victim:on_death(se_attacker)
                end
            end
            return

        -- Kill the victim NPC if the damage dealt exceeds its rank
        elseif wiped or (raw_power - ocs_power[id_2]) > calculate_npc_power(se_victim, community_2, squad_2) then

            -- Post-battle state
            warfare_log.debug("simulate_battle: NPC kill attacker=%s victim_squad=%s victim_npc=%s round=%s damage=%s", id_1, id_2, se_victim.id, round, damage)
            set_battle_outcome(false, id_1, id_2, squad_1, squad_2, community_1, community_2, se_attacker, se_victim, damage)

            if squad_2:npc_count() <= 1 then
                warfare_log.debug("simulate_battle: victim squad depleted after NPC kill, remove squad=%s", id_2)
                remove_squad_info(squad_2, id_2, id_1, lid)
                return
            end

            -- Release killed NPC
            se_victim:on_death(se_attacker)

            -- Recalculate victim power for next round since NPC was lost
            ocs_power[id_2] = calculate_squad_power(squad_2, community_2, true)
            if skirmish then
                skirmish_break_off(id_1, squad_1, id_2, squad_2, se_victim, round)
                return
            end
            if ocs_power[id_2] <= 0 then
                warfare_log.debug("simulate_battle: victim power exhausted, disengage attacker=%s victim=%s", id_1, id_2)
                disengage_combat(id_1, squad_1, id_2, squad_2)
                return
            end
        end
    end
end

function set_battle_outcome(victory, id_1, id_2, squad_1, squad_2, community_1, community_2, se_attacker, se_victim, damage)
    warfare_log.debug("set_battle_outcome: victory=%s attacker_squad=%s victim_squad=%s attacker_npc=%s victim_npc=%s damage=%s", victory and "y" or "n", id_1, id_2, se_attacker and se_attacker.id or "?", se_victim and se_victim.id or "?", damage)

    -- Affect relations
    game_relations.offline_npc_on_death(se_victim, se_attacker)

    -- Send news
    if (not victory) then
        dynamic_news_manager.get_dynamic_news():SOSBattleOffline(squad_2, squad_1)
    end

    if IsStalker(se_attacker) then

        -- Improve attacker rank depending on their damage
        if se_attacker and se_attacker.set_rank then
            local rank_inc = math_ceil(damage / RANK_FRACTION)
            se_attacker:set_rank(se_attacker:rank() + rank_inc)
            ocs_power[id_1] = ocs_power[id_1] + rank_inc
            warfare_log.trace("set_battle_outcome: attacker_rank_gain attacker=%s gain=%s", se_attacker.id, rank_inc)
        end

        -- Record attacker action
        local m_data = alife_storage_manager.get_se_obj_state(se_attacker, true)
        if (m_data) then
            local value = IsStalker(se_victim) and "killed_stalkers" or "killed_monsters"
            m_data[value] = m_data[value] and m_data[value] + 1 or 1
        end

        -- Attackers commander get bonus
        local commander = alife_object(squad_1:commander_id())
        if commander and commander.set_rank then
            local rank_inc = math_random(1, RANK_COMMANDER_GAIN)
            commander:set_rank(commander:rank() + rank_inc)
            ocs_power[id_1] = ocs_power[id_1] + rank_inc
            warfare_log.trace("set_battle_outcome: commander_rank_gain commander=%s gain=%s", commander.id, rank_inc)
        end

    end
end

function disengage_combat(id_1, squad_1, id_t, sq_t)
    warfare_log.trace("disengage_combat: id_1=%s id_t=%s", id_1, id_t)
    -- Clear fight lock so both squads resume normal movement toward their targets
    opponents[id_1] = nil
    opponents[id_t] = nil
    if id_1 and id_t then
        skirmish_incidental[skirmish_pair_key(id_1, id_t)] = nil
    end
    -- Reset cached power so squads recalculate from actual NPC ranks next combat
    ocs_power[id_1] = nil
    ocs_power[id_t] = nil
    -- Clear combat timestamps
    last_combat_time[id_1] = nil
    last_combat_time[id_t] = nil
end

-- Drops id_2 from every combat table; id_1, when given, is the foe whose lock on id_2 is released.
local function clear_squad_state(id_2, id_1, lid)
    ocs_power[id_2] = nil

    if id_1 then
        skirmish_decline[skirmish_pair_key(id_1, id_2)] = nil
        skirmish_incidental[skirmish_pair_key(id_1, id_2)] = nil
        opponents[id_1] = nil
        last_combat_time[id_1] = nil
    end
    opponents[id_2] = nil
    last_combat_time[id_2] = nil
    skirmish_wary[id_2] = nil

    if squads_by_level[lid] then
        squads_by_level[lid][id_2] = nil
    end
    if combatants[lid] then
        combatants[lid][id_2] = nil
    end
    last_x[id_2], last_z[id_2] = nil, nil
end

function remove_squad_info(squad_2, id_2, id_1, lid)
    warfare_log.debug("remove_squad_info: squad=%s opponent=%s lid=%s", id_2 or (squad_2 and squad_2.id), id_1, lid)
    if warfare.sim then
        sim_squad_warfare.remove_squad(squad_2)
    end

    id_2 = id_2 or squad_2.id
    lid = lid or game_graph():vertex(squad_2.m_game_vertex_id):level_id()
    clear_squad_state(id_2, id_1, lid)
end

-- For a squad leaving the simulation by any path: clears its combat state and its foe's lock on it.
function forget_squad(squad)
    local id = squad.id
    local foe = opponents[id]
    if foe and opponents[foe] ~= id then
        foe = nil
    end
    clear_squad_state(id, foe, game_graph():vertex(squad.m_game_vertex_id):level_id())
end


-------------------------------
-- Utilities
-------------------------------
function calculate_npc_power(se_obj, community, squad)
    if warfare_log.tracing() then
        warfare_log.trace("calculate_npc_power: npc=%s community=%s", se_obj and se_obj.id or "?", community)
    end
    local power, cls = 0, se_obj:clsid()
    if IsMonster(nil, cls) then
        power = math_ceil(m_class[cls] * m_rank_max)
        power = math_max(0, power)
        power = math_random(power - (m_rank_factor * power), power + (m_rank_factor * power))
    else
        power = se_obj:rank()
    end

    local mult = 1
    if squad then
        mult = calculate_squad_distance_multiplier(squad, community)
    end

    return (power * (faction_power[community] or 1))* mult
end

function calculate_squad_power(squad, community, raw, no_distance)
    if warfare_log.tracing() then
        warfare_log.trace("calculate_squad_power: squad=%s community=%s raw=%s no_distance=%s", squad and squad.id or "?", community, raw and "y" or "n", no_distance and "y" or "n")
    end
    -- During active combat, ocs_power tracks live damage/rank state — return it directly.
    -- Outside combat, ocs_power is nil (cleared on disengage), so we always recalculate fresh.
    -- This ensures distance multiplier reflects the squad's current position, not a stale cache.
    if (not raw) and ocs_power[squad.id] then
        return ocs_power[squad.id]
    end

    community = community or squad:get_squad_community()

    -- Outside raw (combat) requests the member sum is reused until the squad changes size or the
    -- next coordinator tick, so rank changes and monster rolls refresh at most every UPDATE_TIME.
    local power
    local n = squad:npc_count()
    local rec = (not raw) and squad.wf_member_power
    if rec and rec.n == n and rec.community == community and rec.epoch == power_epoch then
        power = rec.sum
    else
        power = 0
        local sim = alife()
        for k in squad:squad_members() do
            local se_obj = k.id and k.id ~= 65535 and sim:object(k.id)

            if (se_obj) then
                power = power + calculate_npc_power(se_obj, community, nil)
            end
        end
        if not raw then
            squad.wf_member_power = { n = n, community = community, epoch = power_epoch, sum = power }
        end
    end

    if not no_distance then
        power = power * calculate_squad_distance_multiplier(squad, community)
    end
    if community == "monster" and warfare_utils.is_night() then
        power = power * (warfare_options.options.monster_night_power_multiplier or 2)
    end
    power = math_ceil(power)


    return power
end

function get_random_npc(squad)
    if warfare_log.tracing() then
        warfare_log.trace("get_random_npc: squad=%s", squad and squad.id or "?")
    end
    local squad_npcs = {}
    for k in squad:squad_members() do
        local se = k.id and k.id ~= 65535 and alife_object(k.id)
        if se then
            squad_npcs[#squad_npcs + 1] = se
        end
    end
    if #squad_npcs == 0 then
        warfare_log.warn("get_random_npc: empty squad=%s", squad and squad.id or "?")
        return nil
    end
    return squad_npcs[math_random(#squad_npcs)]
end

-- Combined version of vanilla's get_num_squads_on_level: returns active and inactive counts in a single pass
function get_num_squads_on_level_both(lvl, faction)
    warfare_log.trace("get_num_squads_on_level_both: lvl=%s faction=%s", lvl, faction)
    if not squads_by_level[lvl] then
        return 0, 0
    end
    local active, inactive = 0, 0
    for s, _ in pairs(squads_by_level[lvl]) do
        local squad = alife_object(s)
        if squad and squad.get_squad_community and squad:get_squad_community() == faction then
            if squad.current_action == 0 then
                active = active + 1
            elseif squad.current_action == 1 then
                inactive = inactive + 1
            end
        end
    end
    return active, inactive
end


-------------------------------
-- Prepare
-------------------------------
local function load_stationary_squads()
    local ini = ini_file("misc\\offline_combat_simulator.ltx")
    local n = ini:line_count("stationary_squads")
    for i = 0, n - 1 do
        local _, id = ini:r_line_ex("stationary_squads", i, "", "")
        if id then
            stationary_squads[id] = true
        end
    end
    warfare_log.debug("load_stationary_squads: loaded %s stationary_squads", n)
end
load_stationary_squads()


-------------------------------
-- Install
-------------------------------
-- Vanilla functions this module replaces in a warfare game.
local REPLACED = {
    validate_enemy = validate_enemy,
    simulate_battle = simulate_battle,
    set_battle_outcome = set_battle_outcome,
    remove_squad_info = remove_squad_info,
    calculate_npc_power = calculate_npc_power,
    calculate_squad_power = calculate_squad_power,
    get_random_npc = get_random_npc,
}

-- Holds the ("cycle", "ocs") event id. CreateTimeEvent never replaces an existing id pair, so
-- vanilla's on_game_load cannot schedule its coordinator.
local function hold_vanilla_coordinator()
    ResetTimeEvent("cycle", "ocs", 3600)
    return false
end

local function on_game_load()
    warfare_log.info("warfare_offline_combat.on_game_load: registering try_coordinator")
    -- Ownership from the previous session is gone; bootstrap_smart only bumps factions that own something.
    invalidate_distance_cache()
    RegisterScriptCallback("actor_on_update", try_coordinator)
end

local function install_warfare()
    CreateTimeEvent("cycle", "ocs", 3600, hold_vanilla_coordinator)
    warfare_log.info("warfare_offline_combat: vanilla coordinator blocked")

    sim_offline_combat.get_ignore_list()
    for name, fn in pairs(REPLACED) do
        sim_offline_combat[name] = fn
    end
    RegisterScriptCallback("on_game_load", on_game_load)
end

function on_game_start()
    warfare.on_sim(install_warfare)
end
