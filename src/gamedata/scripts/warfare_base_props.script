-- The restrictor piece covering a list's obstacles: one sphere per obstacle, offset from the first.
local function blocker_piece(list)
    local blocker
    for _, piece in ipairs(list) do
        if piece.obstacle then
            blocker = blocker or { key = "ai_blocker", section = SPACE_RESTRICTOR, pos = piece.pos, heading = 0, spheres = {} }
            local p, o = piece.pos, blocker.pos
            table.insert(blocker.spheres, { p[1] - o[1], p[2] - o[2], p[3] - o[3], radius = piece.obstacle })
        end
    end
    return blocker
end

for _, list in pairs(pieces) do
    local blocker = blocker_piece(list)
    if blocker then
        list[#list + 1] = blocker
    end
end

-- What a piece was created with, compared against the list rather than the live object: the engine may
-- renormalize a physic object's stored angle and position.
local function piece_signature(piece)
    local sig = string.format("%.3f,%.3f,%.3f,%.3f", piece.pos[1], piece.pos[2], piece.pos[3], piece.heading)
    if piece.bank then
        sig = string.format("%s,%.3f", sig, piece.bank)
    end
    local visual = piece.visual or piece.lamp and piece.lamp.visual_name
    if visual then
        local bones = piece.fixed_bones or piece.lamp and piece.lamp.lamp_fixed_bones
        sig = string.format("%s|%s:%s", sig, visual, bones or "")
    end
    for _, s in ipairs(piece.spheres or {}) do
        sig = string.format("%s|%.3f,%.3f,%.3f,%.3f", sig, s[1], s[2], s[3], s.radius)
    end
    return piece.ini and sig .. "|" .. piece.ini or sig
end

-- The piece's stored object, if it still exists as that section and matches the listed signature;
-- a stale one is released so the caller recreates it.
local function current(id, piece, signature)
    local se_obj = id and alife_object(id)
    if not (se_obj and se_obj:section_name() == piece.section) then
        return
    end
    if signature ~= piece_signature(piece) then
        alife_release(se_obj)
        return
    end
    return se_obj
end

local function create(piece, gvid)
    local pos = vector():set(piece.pos[1], piece.pos[2], piece.pos[3])
    local lvid = warfare_utils.nearest_lvid(pos)
    if not lvid then
        return
    end

    local se_obj = alife_create(piece.section, pos, lvid, gvid)
    if not se_obj then
        return
    end
    se_obj.angle = vector():set(0, piece.heading, piece.bank or 0)

    if piece.spheres then
        local data = utils_stpk.get_space_restrictor_data(se_obj)
        data.shapes = {}
        for i, s in ipairs(piece.spheres) do
            data.shapes[i] = { shtype = 0, offset = vector():set(s[1], s[2], s[3]), radius = s.radius }
        end
        data.restrictor_type = DEFAULT_IN_RESTRICTOR
        utils_stpk.set_space_restrictor_data(data, se_obj)
        return se_obj.id
    end

    if piece.lamp then
        local data = utils_stpk.get_lamp_data(se_obj)
        for k, v in pairs(piece.lamp) do
            data[k] = v
        end
        utils_stpk.set_lamp_data(data, se_obj)
        return se_obj.id
    end

    -- Physics type and mass stay at the physic_object defaults (skeleton, mass 10): a zero mass
    -- faults the physics world on the first frame.
    local data = utils_stpk.get_physic_data(se_obj)
    if piece.visual then
        data.visual_name = piece.visual
    end
    if piece.fixed_bones then
        data.fixed_bones = piece.fixed_bones
    end
    data.custom_data = piece.ini or COLLIDE_INI
    utils_stpk.set_physic_data(data, se_obj)
    return se_obj.id
end

local function release_unlisted(smart_name, list, ids, signatures)
    local listed = {}
    for _, piece in ipairs(list) do
        listed[piece.key] = true
    end
    for key, id in pairs(ids) do
        if not listed[key] then
            local se_obj = alife_object(id)
            if se_obj then
                alife_release(se_obj)
            end
            ids[key] = nil
            signatures[key] = nil
            warfare_log.info("warfare_base_props: released unlisted smart=%s piece=%s id=%s", smart_name, key, id)
        end
    end
end

local function actor_on_first_update()
    if not IsWarfare() then
        return
    end

    local st = alife_storage_manager.get_state()
    st.warfare_base_props = st.warfare_base_props or {}
    st.warfare_base_props_poses = st.warfare_base_props_poses or {}

    for smart_name, list in pairs(pieces) do
        local smart = warfare_utils.smart_on_actor_level(smart_name)
        if smart and warfare_player_hqs.allows(smart_name) then
            local ids = st.warfare_base_props[smart_name] or {}
            local signatures = st.warfare_base_props_poses[smart_name] or {}
            release_unlisted(smart_name, list, ids, signatures)
            local missing = 0
            for _, piece in ipairs(list) do
                if not current(ids[piece.key], piece, signatures[piece.key]) then
                    ids[piece.key] = create(piece, smart.m_game_vertex_id)
                    signatures[piece.key] = ids[piece.key] and piece_signature(piece)
                    if not ids[piece.key] then
                        missing = missing + 1
                        warfare_log.warn("warfare_base_props: not created smart=%s piece=%s", smart_name, piece.key)
                    end
                end
            end
            st.warfare_base_props[smart_name] = ids
            st.warfare_base_props_poses[smart_name] = signatures
            warfare_log.info("warfare_base_props: smart=%s pieces=%s missing=%s", smart_name, #list, missing)
        end
    end
end

--- The smart a Warfare-created vice belongs to, or nil for any other vice.
function smart_of_vice(id)
    local st = alife_storage_manager.get_state()
    for smart_name, ids in pairs(st.warfare_base_props or {}) do
        if ids.vice == id then
            return SIMBOARD.smarts_by_names[smart_name]
        end
    end
end

--- The smart of the Warfare-created vice the actor stands at (within 2 m), or nil.
function vice_near_actor()
    local pos = db.actor and db.actor:position()
    local st = alife_storage_manager.get_state()
    for smart_name, ids in pairs(pos and st.warfare_base_props or {}) do
        local se_obj = ids.vice and alife_object(ids.vice)
        if se_obj and se_obj.position:distance_to(pos) < 2 then
            return SIMBOARD.smarts_by_names[smart_name]
        end
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
