-- Static props for the installed HQs (warfare_player_hqs): workbench, bar counter, medic corner, beds,
-- lamps. Each piece is created once, the first time the actor is on the HQ smart's level, and its
-- object id is kept in alife storage. A stored piece that is no longer listed is released; one whose
-- listed pose, model or custom data changed is released and recreated. Every piece is pinned by a
-- bone and ignores static geometry, so it can't be pushed and doesn't spam impact sounds. With no
-- HQ installed this module installs nothing.
--
-- Models are Warfare's own copies of vanilla ones (meshes\dynamics\warfare_props): the engine aborts on
-- a fixed bone the model lacks, and other mods replace the vanilla paths with differently-boned models.
--
-- AI paths ignore physics objects, so a smart's obstacle pieces are also fenced off by one default IN
-- space restrictor (every NPC on the level stays out of it), stored as the smart's ai_blocker piece.
--
-- The vice's name (awr_tiski<id>) is what bind_awr and zz_warfare_mech_fix match on.
--
-- A piece: key names it in storage; pos is the model origin, heading in radians (engine getH
-- convention), optional bank rolls the model about its forward axis. visual / fixed_bones override
-- the section's own; ini is the custom data (default kit.COLLIDE_INI). obstacle is the radius NPCs
-- are kept away from its pos by. A lamp piece carries its hanging-lamp properties in lamp; pos is
-- the ceiling point it hangs from.

local SPACE_RESTRICTOR = "space_restrictor"
local DEFAULT_IN_RESTRICTOR = 2

-- Sections, models and custom data the HQ data modules build their pieces from.
kit = {}
kit.PHYSIC_OBJECT = "physic_object"
kit.HANGING_LAMP = "lights_hanging_lamp"

-- Pinned bodies otherwise keep colliding with the floor they stand on.
kit.COLLIDE_INI = "[collide]\nignore_static\n"

-- Pinned bodies still yield to steady contact, so a table carrying pinned items sinks unless the two
-- don't collide: items are small objects and the table ignores small objects.
kit.TABLE_TOP_INI = "[collide]\nignore_static\nignore_small_objects\n"
kit.TABLE_ITEM_INI = "[collide]\nignore_static\nsmall_object\n"

-- Same as all.spawn's scripts\marsh\tiski_01.ltx once access is granted. Without [logic],
-- bind_physic_object leaves the object unbound and it never gets a use callback.
kit.VICE_INI = "[logic]\nactive = ph_idle@warfare_vice\n\n[ph_idle@warfare_vice]\ntips = st_tiski\n\n" .. kit.COLLIDE_INI

kit.PROPS = [[dynamics\warfare_props\]]

kit.TABLE  = kit.PROPS .. "awr_stol_9a_mini" -- 1.52 x 0.65, top 0.851 above its origin
kit.BARREL = kit.PROPS .. "bochka_close_1"
kit.VODKA  = kit.PROPS .. "dev_vodka"
kit.CHAIR  = kit.PROPS .. "stul_wood_01"
kit.MATTRESS = kit.PROPS .. "mattress02"   -- 2.04 x 0.94, 0.11 thick, origin at its underside
kit.MATTRESS_BONES = "bone01_(1),bone01_(2),bone01_(3),bone02_(1),bone02_(2),bone02_(3),bone03"
kit.TROLLEY = kit.PROPS .. "med_stolik_01" -- 0.65 x 0.87, tray 0.91 above its origin
kit.TROLLEY_BONES = "link,korpus_1,korpus_2,other,stoyka_left_1,stoyka_left_2,stoyka_right_1,stoyka_right_2,"
    .. "wheel_left_1,wheel_left_2,wheel_right_1,wheel_right_2"

-- Vanilla all.spawn light_wire_1 (bare bulb on a wire). flags 42 = cast shadow + R2 + point ambient.
kit.WIRE_LAMP = {
    visual_name = kit.PROPS .. "light_wire_1_glass",
    main_color = 0xffffffff, main_brightness = 0.8, main_color_animator = [[light\light_omni_white_idle]],
    main_range = 8, light_flags = 42, lamp_fixed_bones = "link", health = 100,
    main_virtual_size = 0.1, ambient_radius = 2, ambient_power = 0.1, ambient_texture = "", main_texture = "",
    main_bone = "bone_lamp", main_cone_angle = 2.094, glow_texture = "", glow_radius = 0.7, ambient_bone = "bone_omni",
}

-- Vanilla desk lamp (table_lamp_01) as a hanging lamp, standing on a trolley. It has no bone_omni,
-- so the ambient light uses bone_lamp too; every bone is pinned so the arm can't fold.
kit.DESK_LAMP = {
    visual_name = kit.PROPS .. "table_lamp_01",
    main_color = 0xffffffff, main_brightness = 0.7, main_color_animator = [[light\light_omni_white_idle]],
    main_range = 6, light_flags = 42, lamp_fixed_bones = "link,leg1,leg2,in_,out_,bone_lamp,konus", health = 100,
    main_virtual_size = 0.1, ambient_radius = 2, ambient_power = 0.1, ambient_texture = "", main_texture = "",
    main_bone = "bone_lamp", main_cone_angle = 2.094, glow_texture = "", glow_radius = 0.5, ambient_bone = "bone_lamp",
}

-- The restrictor piece covering a list's obstacles: one sphere per obstacle, offset from the first.
local function blocker_piece(list)
    local blocker
    for _, piece in ipairs(list) do
        if piece.obstacle then
            blocker = blocker or { key = "ai_blocker", section = SPACE_RESTRICTOR, pos = piece.pos, heading = 0, spheres = {} }
            local p, o = piece.pos, blocker.pos
            table.insert(blocker.spheres, { p[1] - o[1], p[2] - o[2], p[3] - o[3], radius = piece.obstacle })
        end
    end
    return blocker
end

local lists = {} -- HQ -> its pieces plus the ai_blocker piece

local function pieces_of(hq)
    local list = lists[hq]
    if not list then
        list = {}
        for i, piece in ipairs(hq.pieces) do
            list[i] = piece
        end
        local blocker = blocker_piece(list)
        if blocker then
            list[#list + 1] = blocker
        end
        lists[hq] = list
    end
    return list
end

-- What a piece was created with, compared against the list rather than the live object: the engine may
-- renormalize a physic object's stored angle and position.
local function piece_signature(piece)
    local sig = string.format("%.3f,%.3f,%.3f,%.3f", piece.pos[1], piece.pos[2], piece.pos[3], piece.heading)
    if piece.bank then
        sig = string.format("%s,%.3f", sig, piece.bank)
    end
    local visual = piece.visual or piece.lamp and piece.lamp.visual_name
    if visual then
        local bones = piece.fixed_bones or piece.lamp and piece.lamp.lamp_fixed_bones
        sig = string.format("%s|%s:%s", sig, visual, bones or "")
    end
    for _, s in ipairs(piece.spheres or {}) do
        sig = string.format("%s|%.3f,%.3f,%.3f,%.3f", sig, s[1], s[2], s[3], s.radius)
    end
    return piece.ini and sig .. "|" .. piece.ini or sig
end

-- The piece's stored object, if it still exists as that section and matches the listed signature;
-- a stale one is released so the caller recreates it.
local function current(id, piece, signature)
    local se_obj = id and alife_object(id)
    if not (se_obj and se_obj:section_name() == piece.section) then
        return
    end
    if signature ~= piece_signature(piece) then
        alife_release(se_obj)
        return
    end
    return se_obj
end

local function create(piece, gvid)
    local pos = vector():set(piece.pos[1], piece.pos[2], piece.pos[3])
    local lvid = warfare_utils.nearest_lvid(pos)
    if not lvid then
        return
    end

    local se_obj = alife_create(piece.section, pos, lvid, gvid)
    if not se_obj then
        return
    end
    se_obj.angle = vector():set(0, piece.heading, piece.bank or 0)

    if piece.spheres then
        local data = utils_stpk.get_space_restrictor_data(se_obj)
        data.shapes = {}
        for i, s in ipairs(piece.spheres) do
            data.shapes[i] = { shtype = 0, offset = vector():set(s[1], s[2], s[3]), radius = s.radius }
        end
        data.restrictor_type = DEFAULT_IN_RESTRICTOR
        utils_stpk.set_space_restrictor_data(data, se_obj)
        return se_obj.id
    end

    if piece.lamp then
        local data = utils_stpk.get_lamp_data(se_obj)
        for k, v in pairs(piece.lamp) do
            data[k] = v
        end
        utils_stpk.set_lamp_data(data, se_obj)
        return se_obj.id
    end

    -- Physics type and mass stay at the physic_object defaults (skeleton, mass 10): a zero mass
    -- faults the physics world on the first frame.
    local data = utils_stpk.get_physic_data(se_obj)
    if piece.visual then
        data.visual_name = piece.visual
    end
    if piece.fixed_bones then
        data.fixed_bones = piece.fixed_bones
    end
    data.custom_data = piece.ini or kit.COLLIDE_INI
    utils_stpk.set_physic_data(data, se_obj)
    return se_obj.id
end

local function release_unlisted(smart_name, list, ids, signatures)
    local listed = {}
    for _, piece in ipairs(list) do
        listed[piece.key] = true
    end
    for key, id in pairs(ids) do
        if not listed[key] then
            local se_obj = alife_object(id)
            if se_obj then
                alife_release(se_obj)
            end
            ids[key] = nil
            signatures[key] = nil
            warfare_log.info("warfare_base_props: released unlisted smart=%s piece=%s id=%s", smart_name, key, id)
        end
    end
end

-- Runs in every game: the renegade base exists in every game, and warfare_player_hqs.active keeps
-- the faction HQs to warfare games.
local function actor_on_first_update()
    local st = alife_storage_manager.get_state()
    st.warfare_base_props = st.warfare_base_props or {}
    st.warfare_base_props_poses = st.warfare_base_props_poses or {}

    for _, hq in ipairs(warfare_player_hqs.active()) do
        local smart_name = hq.smart
        local smart = hq.pieces and warfare_utils.smart_on_actor_level(smart_name)
        if smart then
            local list = pieces_of(hq)
            local ids = st.warfare_base_props[smart_name] or {}
            local signatures = st.warfare_base_props_poses[smart_name] or {}
            release_unlisted(smart_name, list, ids, signatures)
            local missing = 0
            for _, piece in ipairs(list) do
                if not current(ids[piece.key], piece, signatures[piece.key]) then
                    ids[piece.key] = create(piece, smart.m_game_vertex_id)
                    signatures[piece.key] = ids[piece.key] and piece_signature(piece)
                    if not ids[piece.key] then
                        missing = missing + 1
                        warfare_log.warn("warfare_base_props: not created smart=%s piece=%s", smart_name, piece.key)
                    end
                end
            end
            st.warfare_base_props[smart_name] = ids
            st.warfare_base_props_poses[smart_name] = signatures
            warfare_log.info("warfare_base_props: smart=%s pieces=%s missing=%s", smart_name, #list, missing)
        end
    end
end

--- The smart a Warfare-created vice belongs to, or nil for any other vice.
function smart_of_vice(id)
    local st = alife_storage_manager.get_state()
    for smart_name, ids in pairs(st.warfare_base_props or {}) do
        if ids.vice == id then
            return SIMBOARD.smarts_by_names[smart_name]
        end
    end
end

--- The smart of the Warfare-created vice the actor stands at (within 2 m), or nil.
function vice_near_actor()
    local pos = db.actor and db.actor:position()
    local st = alife_storage_manager.get_state()
    for smart_name, ids in pairs(pos and st.warfare_base_props or {}) do
        local se_obj = ids.vice and alife_object(ids.vice)
        if se_obj and se_obj.position:distance_to(pos) < 2 then
            return SIMBOARD.smarts_by_names[smart_name]
        end
    end
end

-- The base's service mechanic section (sim_default_<faction>_mechanic), or nil.
local function service_mechanic(smart)
    local board = SIMBOARD.smarts[smart.id]
    for sid in pairs(board and board.squads or {}) do
        local squad = alife_object(sid)
        local commander = squad and alife_object(squad:commander_id())
        local section = commander and commander:section_name()
        if section and section:find("^sim_default_.+_mechanic$") then
            return section
        end
    end
end

local function has_vice()
    for _, hq in ipairs(warfare_player_hqs.registered()) do
        for _, piece in ipairs(hq.pieces or {}) do
            if piece.key == "vice" then
                return true
            end
        end
    end
    return false
end

local function install_workbench()
    -- A Warfare-created vice has no [workshop_angles] row, which bind_awr.access indexes outside warfare.
    local bind_awr_access = bind_awr.access
    function bind_awr.access(obj)
        if obj and smart_of_vice(obj:id()) then
            return true
        end
        return bind_awr_access(obj)
    end

    -- Outside warfare bind_awr opens a Warfare-created vice with no owner; it answers to the base's
    -- mechanic, with the tiers his infoportions record (warfare_tool_tiers owns this in warfare).
    local get_workshop_ui = ui_workshop.get_workshop_ui
    function ui_workshop.get_workshop_ui(hud, mechanic, flags, ...)
        if not (_G.WARFARE or mechanic) and type(flags) == "table" then
            local smart = vice_near_actor()
            mechanic = smart and service_mechanic(smart)
            if mechanic then
                for tier = 1, 3 do
                    flags[tier] = has_alife_info(mechanic .. "_upgrade_tier_" .. tier)
                end
                warfare_log.info("warfare_base_props: workbench smart=%s owner=%s", smart:name(), mechanic)
            end
        end
        return get_workshop_ui(hud, mechanic, flags, ...)
    end
end

function on_game_start()
    if not warfare_player_hqs.any("pieces") then
        return
    end
    if has_vice() then
        install_workbench()
    end
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
