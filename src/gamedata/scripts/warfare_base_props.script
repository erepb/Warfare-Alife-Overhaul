-- Static props Warfare adds to bases that have none in all.spawn (workbench, bar counter, medic corner,
-- lamps). Each piece is created once, the first time the actor is on the smart's level, and its object
-- id is kept in alife storage. A stored piece that is no longer listed is released; one whose listed
-- pose, model or custom data changed is released and recreated. Every piece is pinned by a bone and
-- ignores static geometry, so it can't be pushed and doesn't spam impact sounds.
--
-- Models are Warfare's own copies of vanilla ones (meshes\dynamics\warfare_props): the engine aborts on
-- a fixed bone the model lacks, and other mods replace the vanilla paths with differently-boned models.
--
-- AI paths ignore physics objects, so a smart's obstacle pieces are also fenced off by one default IN
-- space restrictor (every NPC on the level stays out of it), listed as the smart's ai_blocker piece.
--
-- The vice's name (awr_tiski<id>) is what bind_awr and zz_warfare_mech_fix match on.

local PHYSIC_OBJECT = "physic_object"
local HANGING_LAMP = "lights_hanging_lamp"
local SPACE_RESTRICTOR = "space_restrictor"
local DEFAULT_IN_RESTRICTOR = 2

-- Pinned bodies otherwise keep colliding with the floor they stand on.
local COLLIDE_INI = "[collide]\nignore_static\n"

-- Pinned bodies still yield to steady contact, so a table carrying pinned items sinks unless the two
-- don't collide: items are small objects and the table ignores small objects.
local TABLE_TOP_INI = "[collide]\nignore_static\nignore_small_objects\n"
local TABLE_ITEM_INI = "[collide]\nignore_static\nsmall_object\n"

-- Same as all.spawn's scripts\marsh\tiski_01.ltx once access is granted. Without [logic],
-- bind_physic_object leaves the object unbound and it never gets a use callback.
local VICE_INI = "[logic]\nactive = ph_idle@warfare_vice\n\n[ph_idle@warfare_vice]\ntips = st_tiski\n\n" .. COLLIDE_INI

local PROPS = [[dynamics\warfare_props\]]

local TABLE  = PROPS .. "awr_stol_9a_mini" -- 1.52 x 0.65, top 0.851 above its origin
local BARREL = PROPS .. "bochka_close_1"
-- A level vertex is blocked when a corner of its cell is inside. The barman's cell has no cells north
-- of it, so this must stay below 0.28 to keep the two cells west of it open as his way in.
