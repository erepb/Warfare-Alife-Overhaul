-- Faction headquarters, each one a FOMOD option. An option ships the HQ's data module (one of
-- MODULES) and the config hooks that spawn and employ its crew; an HQ whose option is left out
-- has no module, and nothing of it exists. The choice is per playthrough.
--
-- A data module defines `hq`:
--   id, smart      the HQ smart
--   faction        whose HQ it is; its new-game squads are that faction's
--   gate           "always" (every game) or "warfare" (full warfare games)
--   available      optional function; false keeps the HQ out of the world
--   warfare        optional, applied by apply(): entry (main_base_data row; protect = "actor" protects
--                  it only while the actor plays its faction), replaces (a main base of the same
--                  faction that stops being one), props, uniques, capacity, seed ({ section, count }
--                  warfare-owned guards), service (ignore-listed crew squads that find the smart by
--                  their target_smart), seed_start (the new-game start location that alone seeds the
--                  HQ, and only for an actor of its faction)
--   pieces         warfare_base_props pieces
--   anchors        warfare_job_anchors rows: { job, pos, seat }
--   sleep_spot     warfare_sleep_spots bed position
--   hazard_free    where no anomaly may be generated while the HQ is active: boxes as
--                  { x1, y1, z1, x2, y2, z2 }, points for single rows of plugins\dynamic_anomalies.ltx
--
-- apply() rewrites main_base_data, uniques and the smarts' props and capacity, recording every value
-- it replaces, and undoes the previous application first. warfare calls it in fill_start_position
-- (before the starting squads are placed) and in actor_on_first_update (before the first warfare
-- update), so a load or a switch to another faction's save within one session starts from the
-- untouched tables.
--
-- A compatibility module may define `hqs`, a list of such tables, for a base another addon runs
-- (warfare_rr_patch).

local MODULES = { "warfare_hq_renegade", "warfare_hq_sin", "warfare_hq_unisg", "warfare_rr_patch" }

local registry      -- installed HQs, read on first use
local applied = {}  -- what apply() set up, one record per HQ

local function smart_by_name(name)
    return SIMBOARD and SIMBOARD.smarts_by_names[name]
end

--- Every installed HQ.
function registered()
    if not registry then
        registry = {}
        local ids = {}
        for _, name in ipairs(MODULES) do
            local module = _G[name]
            local list = module and (module.hqs or { module.hq })
            for _, hq in ipairs(list or {}) do
                registry[#registry + 1] = hq
                ids[#ids + 1] = hq.id
            end
        end
        local installed = "none"
        if #ids > 0 then
            installed = table.concat(ids, ",")
        end
        warfare_log.info("warfare_player_hqs: installed=%s", installed)
    end
    return registry
end

--- True when an installed HQ has `field`.
function any(field)
    for _, hq in ipairs(registered()) do
        if hq[field] then
            return true
        end
    end
    return false
end

-- Whether hq is in the world in this game.
local function passes(hq)
    if hq.available and not hq.available() then
        return false
    end
    if hq.gate == "always" then
        return true
    end
    return hq.gate == "warfare" and _G.WARFARE == true
end

--- The installed HQs in the world now. It doesn't wait for apply(), so it holds for callers that
--- run before warfare's first update.
function active()
    local list = {}
    for _, hq in ipairs(registered()) do
        if passes(hq) then
            list[#list + 1] = hq
        end
    end
    return list
end

--- True when the HQ with this id is in the world.
function is_active(id)
    for _, hq in ipairs(active()) do
        if hq.id == id then
            return true
        end
    end
    return false
end

--- The HQ in the world at this smart, or nil.
function at_smart(smart_name)
    for _, hq in ipairs(active()) do
        if hq.smart == smart_name then
            return hq
        end
    end
end

local POINT_RADIUS = 0.01

--- True when pos on level_name lies where an active HQ allows no anomaly.
function hazard_free(level_name, pos)
    if not (pos and level_name) then
        return false
    end
    for _, hq in ipairs(active()) do
        local area = hq.hazard_free
        if area and level_name == area.level then
            for _, b in ipairs(area.boxes or {}) do
                if pos.x >= b[1] and pos.x <= b[4] and pos.y >= b[2] and pos.y <= b[5]
                    and pos.z >= b[3] and pos.z <= b[6] then
                    return true
                end
            end
            for _, p in ipairs(area.points or {}) do
                if pos:distance_to(vector():set(p[1], p[2], p[3])) < POINT_RADIUS then
                    return true
                end
            end
        end
    end
    return false
end

-- Main bases, uniques, props, capacity -------------------------------------------------------

-- bootstrap_smart copies max_population into default_max_population and scales it by the pop
-- factor, so before the bootstrap the raw value goes into max_population.
local function raw_capacity(smart)
    return smart.first_update and smart.default_max_population or smart.max_population
end

local function set_capacity(smart, cap)
    if smart.first_update then
        smart.default_max_population = cap
        smart_terrain_warfare.set_max_population(smart)
    else
        smart.max_population = cap
    end
end

local function replace_base(rec, name, entry)
    rec.bases[name] = { entry = smart_terrain_warfare.get_main_base(name) }
    smart_terrain_warfare.set_main_base(name, entry)
end

-- entry with protect = "actor" resolved for an actor of `faction`
local function resolve_entry(entry, faction)
    if entry.protect ~= "actor" then
        return entry
    end
    local resolved = {}
    for k, v in pairs(entry) do
        resolved[k] = v
    end
    resolved.protect = faction ~= nil and faction == entry.faction
    return resolved
end

local function apply_one(hq, smart, faction)
    local w = hq.warfare
    local rec = { hq = hq, bases = {}, props = {} }

    if w.entry then
        replace_base(rec, hq.smart, resolve_entry(w.entry, faction))
        if w.replaces and smart_terrain_warfare.get_main_base_faction(w.replaces) == w.entry.faction then
            replace_base(rec, w.replaces, nil)
        end
    end

    if w.uniques then
        rec.uniques = { name = hq.smart, row = smart_terrain_warfare.uniques[hq.smart] }
        smart_terrain_warfare.uniques[hq.smart] = { unpack(w.uniques) }
    end

    for name, values in pairs(w.props or {}) do
        local s = smart_by_name(name)
        if s then
            if not s.props then
                simulation_objects.get_props(s)
            end
            local old, absent = {}, {}
            for k, v in pairs(values) do
                if s.props[k] == nil then
                    absent[k] = true
                end
                old[k] = s.props[k]
                s.props[k] = v
            end
            rec.props[name] = { smart = s, values = old, absent = absent }
        end
    end

    -- after the props: set_max_population scales a base by the stalker factor, a lair by the mutant one
    if w.capacity then
        local raw = raw_capacity(smart)
        rec.capacity = { name = hq.smart, smart = smart, raw = raw }
        set_capacity(smart, math.max(raw or 0, w.capacity))
    end

    warfare_log.info("warfare_player_hqs: applied hq=%s smart=%s capacity=%s", hq.id, hq.smart, raw_capacity(smart))
    return rec
end

-- Smart objects from a previous save are only compared against, never touched.
local function revert_one(rec)
    for name, b in pairs(rec.bases) do
        smart_terrain_warfare.set_main_base(name, b.entry)
    end
    if rec.uniques then
        smart_terrain_warfare.uniques[rec.uniques.name] = rec.uniques.row
    end
    for name, p in pairs(rec.props) do
        local smart = smart_by_name(name)
        if smart and smart == p.smart and smart.props then
            for k, v in pairs(p.values) do
                smart.props[k] = v
            end
            for k in pairs(p.absent) do
                smart.props[k] = nil
            end
        end
    end
    local cap = rec.capacity
    if cap then
        local smart = smart_by_name(cap.name)
        if smart and smart == cap.smart then
            set_capacity(smart, cap.raw)
        end
    end
    warfare_log.info("warfare_player_hqs: reverted hq=%s", rec.hq.id)
end

--- Applies the warfare part of every HQ in the world for an actor of `faction`, after undoing the
--- previous application.
function apply(faction)
    for i = #applied, 1, -1 do
        revert_one(applied[i])
    end
    applied = {}
    for _, hq in ipairs(registered()) do
        if hq.warfare and passes(hq) then
            local smart = smart_by_name(hq.smart)
            if smart then
                applied[#applied + 1] = apply_one(hq, smart, faction)
            else
                warfare_log.warn("warfare_player_hqs: smart=%s not found, hq=%s not applied", hq.smart, hq.id)
            end
        end
    end
end

--- The applied HQs' new-game squads, a list of { smart, faction, section, count, service }.
--- section/count are the warfare-owned guards (section nil when none); service lists the
--- ignore-listed unique NPC squads, which find the smart by their target_smart.
--- `start` is the chosen new-game start location and `actor_faction` the actor's: an HQ with a
--- seed_start is seeded only for an actor of its faction starting there.
function new_game_seed(start, actor_faction)
    local list = {}
    for _, rec in ipairs(applied) do
        local hq = rec.hq
        local w = hq.warfare
        local smart = (w.seed or w.service) and smart_by_name(hq.smart)
        if smart then
            if w.seed_start and not (w.seed_start == start and actor_faction == hq.faction) then
                warfare_log.info("warfare_player_hqs: start=%s faction=%s, smart=%s starts empty", start, actor_faction, hq.smart)
            else
                local seed = w.seed or {}
                list[#list + 1] = {
                    smart   = smart,
                    faction = hq.faction,
                    section = seed.section,
                    count   = seed.count or 0,
                    service = w.service or {},
                }
            end
        end
    end
    return list
end

-- Dynamic anomalies ------------------------------------------------------------------------------

local ANOMALY_TABLE = "plugins\\dynamic_anomalies.ltx"

-- bind_anomaly_field's coordinate table, with the rows inside an active HQ read as its "NA" skip.
local function anomaly_table(path)
    local ini = ini_file(path)
    if path ~= ANOMALY_TABLE then
        return ini
    end
    local proxy = {}
    function proxy:line_count(section)
        return ini:line_count(section)
    end
    function proxy:r_line_ex(section, i, ...)
        local result, name, value = ini:r_line_ex(section, i, ...)
        local t = value and str_explode(value, ",")
        local x, y, z = t and tonumber(t[2]), t and tonumber(t[3]), t and tonumber(t[4])
        if t and #t == 6 and x and y and z and hazard_free(section, vector():set(x, y, z)) then
            warfare_log.info("warfare_player_hqs: no dynamic anomaly row=%s level=%s, inside the HQ", name, section)
            value = "NA"
        end
        return result, name, value
    end
    return proxy
end

local function install_anomaly_filter()
    local module = bind_anomaly_field
    local ini_settings = module and module.ini_settings
    if type(ini_settings) ~= "function" then
        return
    end
    module.ini_settings = function(...)
        module.ini_file = anomaly_table
        local ok, err = pcall(ini_settings, ...)
        module.ini_file = nil
        if not ok then
            error(err, 0)
        end
    end
end

function on_game_start()
    if any("hazard_free") then
        warfare.on_enabled(install_anomaly_filter)
    end
end
