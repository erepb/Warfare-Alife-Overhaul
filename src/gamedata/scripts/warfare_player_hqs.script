-- Faction headquarters that exist only while the actor plays that faction: the Sin mine in the Red
-- Forest and the UNISG depot on Jupiter, after GeroyAnekdotov's WALO SIN HQ and UNISG Command &
-- Operations. The story-mode flag plays no part. For any other player faction the world stays as
-- warfare_smarts.ltx and smart_terrain_warfare.uniques describe it.
--
-- apply() rewrites main_base_data, uniques and the smarts' props and capacity, recording every value
-- it replaces, and undoes the previous application first. warfare calls it in fill_start_position
-- (before the starting squads are placed) and in actor_on_first_update (before the first warfare
-- update), so a load or a switch to another faction's save within one session starts from the
-- untouched tables. The HQ's furniture, sleep spot and seat anchors live in warfare_base_props,
-- warfare_sleep_spots and warfare_job_anchors, gated by allows(); its jobs in the smart's
-- *_warfare_logic.ltx.
--
-- hazard_free is where no anomaly may be generated while the HQ is the actor's: boxes as
-- { x1, y1, z1, x2, y2, z2 }, and points for single rows of plugins\dynamic_anomalies.ltx.

local hqs = {
    greh = {
        smart    = "red_smart_terrain_3_2",                     -- the old mine
        entry    = { faction = "greh", protect = true, resurrect = true },
        replaces = "red_smart_terrain_4_2",                     -- the surface camp
        -- the faction key also marks the base as the faction's own for GAMMA's campfire saving (YACS)
        props    = {
            red_smart_terrain_3_2 = { base = 1, resource = 0, territory = 0, lair = 0, greh = 1 },
            red_smart_terrain_4_2 = { base = 0, resource = 1, territory = 0, lair = 0 },
        },
        uniques  = { 1, 1, 1, 1, 0 },                           -- trader, mechanic, medic, barman
        capacity = 4,
        -- squad_descr_warfare.ltx; the trader and the mechanic are simulation.ltx's story squads
        service  = { "red_smart_terrain_3_2_greh_medic_squad", "red_smart_terrain_3_2_greh_barman_squad" },
        hazard_free = { level = "l10_red_forest", boxes = { { -173.5, 0, -46, -144, 6, -15 } } },
        available = function()
            return not warfare_redone_patch.moves_sin_base()
        end,
    },
    isg = {
        smart    = "jup_b208",                                  -- the depot
        entry    = { faction = "isg", resurrect = true },
        props    = {
            jup_b208 = { base = 1, isg = 1 },
        },
        uniques  = { 1, 1, 1, 1, 0 },
        capacity = 4,
        seed     = { section = "isg_sim_squad_novice", count = 2 },
        service  = { "jup_b208_isg_trader_squad", "jup_b208_isg_mechanic_squad",
                     "jup_b208_isg_medic_squad", "jup_b208_isg_barman_squad" },
        -- new_game_start_locations.ltx: from any other start the depot is left empty to be captured
        seed_start = "yanov_depo_monolith",
        -- the hall, the room by the exit and the stair footprint (all.spawn's jup_b208_burers_restr
        -- and jup_surge_hide_b208_2, as measured by UNISG Command & Operations 1.2.0); ano_jup_158 at
        -- the exit
        hazard_free = { level = "jupiter",
            boxes  = { { 387.01551, -0.42500, -137.64774, 417.83971, 14.31620, -85.44132 },
                       { 424.26614,  3.67648,  -74.18181, 429.32694, 11.96648, -67.25081 },
                       { 417.33313,  4.27900, -109.72678, 420.59033,  7.63307, -100.76898 } },
            points = { { 421.97360, 4.45509, -73.03874 } } },
    },
}

local hq_faction_by_smart = {}
for faction, hq in pairs(hqs) do
    hq_faction_by_smart[hq.smart] = faction
end

local active -- the applied HQ, or nil
local undo   -- what the applied HQ replaced

local function smart_by_name(name)
    return SIMBOARD and SIMBOARD.smarts_by_names[name]
end

local function hq_of(faction)
    local hq = faction and hqs[faction]
    if hq and _G.WARFARE and (not hq.available or hq.available()) then
        return hq
    end
end

-- bootstrap_smart copies max_population into default_max_population and scales it by the pop
-- factor, so before the bootstrap the raw value goes into max_population.
local function raw_capacity(smart)
    return smart.first_update and smart.default_max_population or smart.max_population
end

local function set_capacity(smart, cap)
    if smart.first_update then
        smart.default_max_population = cap
        smart_terrain_warfare.set_max_population(smart)
    else
        smart.max_population = cap
    end
end

local function replace_base(name, entry)
    undo.bases[name] = { entry = smart_terrain_warfare.get_main_base(name) }
    smart_terrain_warfare.set_main_base(name, entry)
end

-- Smart objects from a previous save are only compared against, never touched.
local function revert()
    if not undo then
        return
    end
    for name, rec in pairs(undo.bases) do
        smart_terrain_warfare.set_main_base(name, rec.entry)
    end
    if undo.uniques then
        smart_terrain_warfare.uniques[undo.uniques.name] = undo.uniques.row
    end
    for name, rec in pairs(undo.props) do
        local smart = smart_by_name(name)
        if smart and smart == rec.smart and smart.props then
            for k, v in pairs(rec.values) do
                smart.props[k] = v
            end
        end
    end
    local cap = undo.capacity
    if cap then
        local smart = smart_by_name(cap.name)
        if smart and smart == cap.smart then
            set_capacity(smart, cap.raw)
        end
    end
    warfare_log.info("warfare_player_hqs: reverted smart=%s", active and active.smart)
    undo, active = nil, nil
end

--- Makes the HQ of `faction` (the actor's) the faction's main base, or only undoes the previous one.
function apply(faction)
    revert()
    local hq = hq_of(faction)
    if not hq then
        return
    end
    local smart = smart_by_name(hq.smart)
    if not smart then
        warfare_log.warn("warfare_player_hqs: smart=%s not found, faction=%s keeps its stock bases", hq.smart, faction)
        return
    end

    undo = { bases = {}, props = {} }
    replace_base(hq.smart, hq.entry)
    if hq.replaces and smart_terrain_warfare.get_main_base_faction(hq.replaces) == faction then
        replace_base(hq.replaces, nil)
    end

    local row = smart_terrain_warfare.uniques[hq.smart]
    undo.uniques = { name = hq.smart, row = row }
    smart_terrain_warfare.uniques[hq.smart] = { unpack(hq.uniques) }

    for name, values in pairs(hq.props or {}) do
        local s = smart_by_name(name)
        if s then
            if not s.props then
                simulation_objects.get_props(s)
            end
            local old = {}
            for k, v in pairs(values) do
                old[k] = s.props[k]
                s.props[k] = v
            end
            undo.props[name] = { smart = s, values = old }
        end
    end

    -- after the props: set_max_population scales a base by the stalker factor, a lair by the mutant one
    local raw = raw_capacity(smart)
    undo.capacity = { name = hq.smart, smart = smart, raw = raw }
    set_capacity(smart, math.max(raw or 0, hq.capacity))

    active = hq
    warfare_log.info("warfare_player_hqs: applied faction=%s smart=%s capacity=%s", faction, hq.smart, raw_capacity(smart))
end

--- The applied HQ's faction and smart name, or nil.
function active_hq()
    if active then
        return active.entry.faction, active.smart
    end
end

--- The applied HQ's new-game squads, or nil: { smart, faction, section, count, service }.
--- section/count are the warfare-owned guards (section nil when none); service lists the
--- ignore-listed unique NPC squads, which find the smart by their target_smart.
--- `start` is the chosen new-game start location; an HQ with a seed_start other than it gets nil.
function new_game_seed(start)
    local smart = active and smart_by_name(active.smart)
    if not smart then
        return
    end
    if active.seed_start and active.seed_start ~= start then
        warfare_log.info("warfare_player_hqs: start=%s is not %s, smart=%s starts empty", start, active.seed_start, active.smart)
        return
    end
    local seed = active.seed or {}
    return {
        smart   = smart,
        faction = active.entry.faction,
        section = seed.section,
        count   = seed.count or 0,
        service = active.service or {},
    }
end

--- False for a faction HQ smart that is not the actor's HQ: its furniture, sleep spot and seat
--- anchors stay out of the world.
function allows(smart_name)
    local faction = hq_faction_by_smart[smart_name]
    if not faction then
        return true
    end
    return db.actor ~= nil and hq_of(get_actor_true_community()) == hqs[faction]
end

--- The actor's HQ faction and smart name, or nil. Unlike active_hq() it doesn't wait for apply(),
--- so it holds for callers that run before warfare's first update.
function current_hq()
    local hq = db.actor and hq_of(get_actor_true_community())
    if hq then
        return hq.entry.faction, hq.smart
    end
end

local POINT_RADIUS = 0.01

--- True when pos on level_name lies where the actor's HQ allows no anomaly.
function hazard_free(level_name, pos)
    local hq = db.actor and hq_of(get_actor_true_community())
    local area = hq and hq.hazard_free
    if not (area and pos and level_name == area.level) then
        return false
    end
    for _, b in ipairs(area.boxes or {}) do
        if pos.x >= b[1] and pos.x <= b[4] and pos.y >= b[2] and pos.y <= b[5]
            and pos.z >= b[3] and pos.z <= b[6] then
            return true
        end
    end
    for _, p in ipairs(area.points or {}) do
        if pos:distance_to(vector():set(p[1], p[2], p[3])) < POINT_RADIUS then
            return true
        end
    end
    return false
end

-- Dynamic anomalies ------------------------------------------------------------------------------

local ANOMALY_TABLE = "plugins\\dynamic_anomalies.ltx"

-- bind_anomaly_field's coordinate table, with the rows inside the actor's HQ read as its "NA" skip.
local function anomaly_table(path)
    local ini = ini_file(path)
    if path ~= ANOMALY_TABLE then
        return ini
    end
    local proxy = {}
    function proxy:line_count(section)
        return ini:line_count(section)
    end
    function proxy:r_line_ex(section, i, ...)
        local result, name, value = ini:r_line_ex(section, i, ...)
        local t = value and str_explode(value, ",")
        local x, y, z = t and tonumber(t[2]), t and tonumber(t[3]), t and tonumber(t[4])
        if t and #t == 6 and x and y and z and hazard_free(section, vector():set(x, y, z)) then
            warfare_log.info("warfare_player_hqs: no dynamic anomaly row=%s level=%s, inside the HQ", name, section)
            value = "NA"
        end
        return result, name, value
    end
    return proxy
end

local function install_anomaly_filter()
    local module = bind_anomaly_field
    local ini_settings = module and module.ini_settings
    if type(ini_settings) ~= "function" then
        return
    end
    module.ini_settings = function(...)
        module.ini_file = anomaly_table
        local ok, err = pcall(ini_settings, ...)
        module.ini_file = nil
        if not ok then
            error(err, 0)
        end
    end
end

function on_game_start()
    warfare.on_enabled(install_anomaly_filter)
end
