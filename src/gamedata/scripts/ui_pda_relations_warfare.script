--- The vanilla Relations tab, annotated with the way warfare has moved each pair today.
---
--- The matrix is described to the shared code by a grid table built once per tab instance:
---   list            faction codes, one per column
---   last_row        highest row index (rows run 0..last_row)
---   row(k)          faction code for row k; nil for the actor goodwill row; false for a row
---                   warfare has nothing to say about
---   arrow[k][i]     warfare-owned CUIStatic per cell, hidden by default
---   value[k][i]     optional CUITextWnd per cell that warfare fills; absent when another mod owns
---                   the cell text
---   status_left/right   the two status TextWnds
---   origin, dx, dy  cell [row 0][col 1] and the pitch between neighbours, for the hit test
---   arrows_on()     whether arrows and the per-cell hint may show right now
---   status_on()     whether the status line may show right now
---
--- Two grid constructors exist. The one here draws warfare's own 12-faction matrix: vanilla lists
--- nine factions and its matrix is suppressed rather than torn down - emptying self.list before
--- its InitControls runs leaves its build and fill loops with nothing to iterate, so every other
--- control on the tab is still built and driven by vanilla code. ui_pda_relations_warfare_safr
--- overlays SAFR's matrix instead when that mod owns the tab class.
---
--- With the relation_pacing option off nothing of the pacing layer shows: no arrows, hint or
--- status line, and no SAFR overlay at all. Warfare's own matrix still replaces vanilla's.
---
--- All three overrides chain to the original: modxml_portrait_cover also wraps Reset.

local TEMPLATES = "ui_warfare_relations.xml"

local GRID_X = 100              -- tab-relative, and what the layout's backdrop is sized to
local GRID_Y = 84
local COL_W = 57
local ROW_H = 28
local LABEL_X = 40
local LABEL_W = 60
-- The UI is one unscaled 1024x768 space that the renderer stretches to the screen, so on 16:9 a
-- layout unit is ~1.333 times wider than it is tall. Art sized here has to be pre-squashed by that
-- factor to come out at its own proportions: ui_inGame4_ico_* is 127x56, and 43x24 renders as
-- about 57x24 - vanilla's own ratio for this art.
local LOGO_W = 43
local LOGO_H = 24
local HEADER_Y = 56
local ARROW_W = 4               -- 16x27 art with no padding, so the box is the arrow
local ARROW_H = 9
local ARROW_DX = 1
local ARROW_DY = 1

-- One in-game minute: the tick warfare.actor_on_update throttles itself to, which is the rate at
-- which the pending totals shown here are actually produced.
local REFRESH_SEC = 60

-- Muted against the cell values, which keep the saturated palette vanilla chose for standings.
local CLR_UP = GetARGB(255, 110, 165, 110)
local CLR_DOWN = GetARGB(255, 180, 100, 95)
-- The pair has spent its allowance: it moved, and cannot move again until tomorrow.
local CLR_BLOCKED = GetARGB(255, 125, 125, 125)

local clr_w = utils_xml.get_color("white")
local clr_gr = utils_xml.get_color("ui_gray_1")

local function switch_on()
    return warfare_options.options.relation_pacing and true or false
end

local function signed(n)
    return string.format("%+d", math.floor((tonumber(n) or 0) + 0.5))
end

local function roster()
    local factions = game_relations.factions_table
    if not factions then
        warfare_log.err("ui_pda_relations_warfare.roster: game_relations.factions_table missing")
        return {}
    end
    return factions
end

local function logo(xml, tab, faction, x, y)
    local ico = xml:InitStatic("tab:faction_logo", tab)
    ico:InitTexture("ui_inGame4_ico_" .. faction)
    ico:SetStretchTexture(true)
    ico:SetWndPos(vector2():set(x, y))
    ico:SetWndSize(vector2():set(LOGO_W, LOGO_H))
    return ico
end

--- A hidden arrow in the top-right corner of the cell whose left edge, top edge and width are
--- given.
function cell_arrow(xml, tab, x, y, w)
    local a = xml:InitStatic("tab:cell_arrow", tab)
    a:SetStretchTexture(true)
    a:SetWndPos(vector2():set(x + w - ARROW_W - ARROW_DX, y + ARROW_DY))
    a:SetWndSize(vector2():set(ARROW_W, ARROW_H))
    a:Show(false)
    return a
end

local function always()
    return true
end

-- Warfare's own matrix.
local own = { name = "own" }

function own.prepare(self)
    self.list = {}
end

--- Every Init call returns a fresh window, so the layout carries one template per kind of node and
--- this draws as many of each as the roster needs.
function own.build(self, xml)
    local list = roster()
    local cols = #list
    if cols == 0 then
        return nil
    end

    local tab = self.tab
    local rows = cols + 1       -- row 0 is the actor's standing with each faction

    for c = 0, cols do
        local line = xml:InitStatic("tab:grid_v", tab)
        line:SetWndPos(vector2():set(GRID_X + c * COL_W, GRID_Y))
        line:SetWndSize(vector2():set(1, rows * ROW_H))
    end
    for r = 0, rows do
        local line = xml:InitStatic("tab:grid_h", tab)
        line:SetWndPos(vector2():set(GRID_X, GRID_Y + r * ROW_H))
        line:SetWndSize(vector2():set(cols * COL_W, 1))
    end

    for i = 1, cols do
        logo(xml, tab, list[i], GRID_X + (i - 1) * COL_W + math.floor((COL_W - LOGO_W) / 2),
            HEADER_Y)
    end

    local grid = {
        list = list,
        last_row = cols,
        arrow = {},
        value = {},
        dx = COL_W,
        dy = ROW_H,
        arrows_on = always,
        status_on = always,
    }
    function grid.row(k)
        if k == 0 then
            return nil
        end
        return list[k]
    end

    for k = 0, cols do
        local y = GRID_Y + k * ROW_H

        if k == 0 then
            local label = xml:InitTextWnd("tab:goodwill_label", tab)
            label:SetWndPos(vector2():set(LABEL_X, y))
            label:SetWndSize(vector2():set(LABEL_W, ROW_H))
            label:SetText(game.translate_string("st_ui_goodwill_name"))
        else
            logo(xml, tab, list[k], LABEL_X + math.floor((LABEL_W - LOGO_W) / 2),
                y + math.floor((ROW_H - LOGO_H) / 2))
        end

        grid.value[k] = {}
        grid.arrow[k] = {}
        for i = 1, cols do
            local x = GRID_X + (i - 1) * COL_W

            -- The value spans the whole cell, which also makes it the cell's hit target.
            local cell = xml:InitTextWnd("tab:cell_value", tab)
            cell:SetWndPos(vector2():set(x, y))
            cell:SetWndSize(vector2():set(COL_W, ROW_H))
            grid.value[k][i] = cell
            grid.arrow[k][i] = cell_arrow(xml, tab, x, y, COL_W)
        end
    end
    grid.origin = grid.value[0][1]

    grid.status_left = xml:InitTextWnd("tab:status_left", tab)
    grid.status_right = xml:InitTextWnd("tab:status_right", tab)
    return grid
end

local function goodwill_string(v)
    if v >= 2000 then
        return "st_ui_goodwill_5"
    end
    if v >= 1500 then
        return "st_ui_goodwill_4"
    end
    if v >= 1000 then
        return "st_ui_goodwill_3"
    end
    if v >= 500 then
        return "st_ui_goodwill_2"
    end
    return "st_ui_goodwill_1"
end

local function fill_status(wf, paced, cfg)
    if not (wf.status_on() and switch_on()) then
        wf.status_left:SetText("")
        wf.status_right:SetText("")
        return
    end

    -- Warfare would pace, but the vanilla master switch is off.
    if not paced then
        wf.status_left:SetText(game.translate_string("st_wrfr_rel_static"))
        wf.status_right:SetText("")
        return
    end

    local remaining = warfare_relations.FLUSH_INTERVAL - (warfare_relations.flush_accum or 0)
    if remaining < 0 then
        remaining = 0
    end
    wf.status_left:SetText(strformat(game.translate_string("st_wrfr_rel_flush"),
        smart_terrain_warfare.format_game_minutes(math.floor(remaining / 60))))

    if cfg.budget > 0 then
        wf.status_right:SetText(strformat(game.translate_string("st_wrfr_rel_budget"),
            cfg.budget))
    else
        wf.status_right:SetText(game.translate_string("st_wrfr_rel_nolimit"))
    end
end

local function fill_value(self, cell, row, col)
    local as_text = self.to_text
    if not row then
        local g = relation_registry.community_goodwill(col, AC_ID)
        cell:SetTextColor((g >= 2000 and self.clr_green)
            or (g >= 500 and self.clr_yellow) or self.clr_red)
        cell:SetText(as_text and game.translate_string(goodwill_string(g)) or tostring(g))
        return
    end
    local r = relation_registry.community_relation(row, col)
    local state = "st_goodwill_indifferent"
    if r >= game_relations.FRIENDS then
        cell:SetTextColor(self.clr_green)
        state = "st_goodwill_friendly"
    elseif r <= game_relations.ENEMIES then
        cell:SetTextColor(self.clr_red)
        state = "st_goodwill_enemy"
    else
        cell:SetTextColor(self.clr_yellow)
    end
    cell:SetText(as_text and game.translate_string(state) or tostring(r))
end

--- Cell (row k, column i) is how faction k sees faction i, which is the orientation vanilla used.
--- The goodwill row is the actor's standing with each faction - a different registry, not
--- symmetric with anything else in the grid, and never something warfare paces.
local function fill(self)
    local wf = self.wf
    local list = wf.list
    local paced = warfare_relations.enabled()
    local cfg = paced and warfare_relations.settings() or nil
    local show_arrows = paced and wf.arrows_on()

    -- Kept for the hint, which runs per frame and must agree with what the arrows are showing.
    self.wf_paced = paced
    self.wf_cfg = cfg

    fill_status(wf, paced, cfg)

    for k = 0, wf.last_row do
        local row = wf.row(k)
        if row ~= false then
            for i = 1, #list do
                local col = list[i]
                local a = wf.arrow[k][i]
                a:Show(false)

                if wf.value then
                    fill_value(self, wf.value[k][i], row, col)
                end

                if row and show_arrows and warfare_relations.pair_allowed(row, col) then
                    -- Direction the pair has moved today, greyed once its daily allowance is gone.
                    local moved = warfare_relations.moved_today(row, col)
                    if moved ~= 0 then
                        local _, _, _, room = warfare_relations.preview(row, col, cfg)
                        a:InitTexture(moved > 0 and [[ui\ui_warfare_arrow_up]]
                            or [[ui\ui_warfare_arrow_down]])
                        a:SetTextureColor((room == 0 and CLR_BLOCKED)
                            or (moved > 0 and CLR_UP) or CLR_DOWN)
                        a:Show(true)
                    end
                end
            end
        end
    end
end

--- Indexed off a real cell's absolute rect: the cells are one pitch apart in whatever space that
--- rect is in.
local function cell_at(self, pos)
    local wf = self.wf
    local cols = #wf.list
    local rect = Frect():set(0, 0, 0, 0)
    wf.origin:GetAbsoluteRect(rect)
    local x = pos.x - rect.x1
    local y = pos.y - rect.y1
    if x < 0 or y < 0 or x >= cols * wf.dx or y >= (wf.last_row + 1) * wf.dy then
        return nil
    end
    local k = math.floor(y / wf.dy)
    if wf.row(k) == false then
        return nil
    end
    return k, math.floor(x / wf.dx) + 1
end

--- The headers are faction logos and the badge is a bare arrow; the hint carries the numbers.
local function hint_text(self, k, i)
    local col = self.wf.list[i]
    local row = self.wf.row(k)

    if not row then
        return clr_w .. game.translate_string(col) .. "\\n"
            .. clr_gr .. game.translate_string("st_wrfr_rel_goodwill") .. ": "
            .. clr_w .. relation_registry.community_goodwill(col, AC_ID)
    end

    local out = clr_w .. game.translate_string(row) .. " -> " .. game.translate_string(col)
        .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_standing") .. ": "
        .. clr_w .. relation_registry.community_relation(row, col)

    if not self.wf_paced then
        return out
    end
    if not warfare_relations.pair_allowed(row, col) then
        return out .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_excluded")
    end

    local key = warfare_relations.pair_key(row, col)
    local canon = warfare_relations.anchor_for(key)
    out = out .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_canon") .. ": "
        .. clr_w .. math.floor(canon)
        .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_drift") .. ": "
        .. clr_w .. signed(warfare_relations.current(row, col) - canon)
    if self.wf_cfg then
        out = out .. " / " .. math.floor(self.wf_cfg.cap)
    end

    local _, step, _, room = warfare_relations.preview(row, col, self.wf_cfg)
    out = out .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_moved") .. ": "
        .. clr_w .. signed(warfare_relations.moved_today(row, col))
        .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_lands") .. ": "
        .. clr_w .. signed(step)
    if room then
        out = out .. "\\n" .. clr_gr .. game.translate_string("st_wrfr_rel_today") .. ": "
            .. clr_w .. math.floor(room)
    end
    return out
end

local function install()
    -- A script class lives in its own module table; _G is the fallback modxml_portrait_cover uses.
    local cls = (ui_pda_relations_tab and ui_pda_relations_tab.pda_relations_tab)
        or _G.pda_relations_tab
    if not cls then
        warfare_log.err("ui_pda_relations_warfare.on_game_start: pda_relations_tab class missing")
        return
    end
    if cls.__warfare_matrix then
        return
    end
    cls.__warfare_matrix = true

    local ctor = ui_pda_relations_warfare_safr.owns(cls) and ui_pda_relations_warfare_safr or own
    warfare_log.debug("ui_pda_relations_warfare.on_game_start: patching the relations matrix (%s)",
        ctor.name)

    local original_init = cls.InitControls
    cls.InitControls = function(self, ...)
        ctor.prepare(self)
        local res = original_init(self, ...)

        -- The SAFR overlay is nothing but pacing decoration and SAFR rebuilds its tab on every
        -- open; warfare's own grid is the matrix itself and is built once, so it is always built
        -- and its pacing parts stay hidden until the switch is on.
        if ctor ~= own and not switch_on() then
            return res
        end
        local xml = CScriptXmlInit()
        xml:ParseFile(TEMPLATES)
        self.wf = ctor.build(self, xml)
        if self.wf then
            -- Its own hint, not the tab's: vanilla ends every Update with a bare hint_wnd:Update(),
            -- and UIHint:Pass treats that as "no text" and rearms its delay timer. Anything written
            -- to that window afterwards is inside the fresh delay window and is refused, every
            -- frame, forever.
            self.wf_hint = utils_ui.UIHint(self)
            warfare_log.debug("ui_pda_relations_warfare.InitControls: %s grid, %s columns, %s rows",
                ctor.name, #self.wf.list, self.wf.last_row + 1)
        end
        return res
    end

    local original_reset = cls.Reset
    cls.Reset = function(self, ...)
        local res = original_reset(self, ...)
        if self.wf then
            fill(self)
        end
        return res
    end

    local original_update = cls.Update
    cls.Update = function(self, ...)
        local res = original_update(self, ...)
        if not self.wf then
            return res
        end

        -- CUIPdaWnd only drives the active subdialog, so this ticks only while the tab is open.
        -- The CTime never leaves the panel and is never saved.
        local now = warfare.get_time_ref()
        if not self.wf_next_fill then
            self.wf_next_fill = warfare_utils.add_time(now, REFRESH_SEC)
        elseif self.wf_next_fill:diffSec(now) <= 0 then
            self.wf_next_fill = warfare_utils.add_time(now, REFRESH_SEC)
            fill(self)
        end

        -- mouse_over_id means vanilla already claimed a hint for a companion portrait.
        local k, i
        if not self.mouse_over_id and switch_on() and self.wf.arrows_on() then
            k, i = cell_at(self, GetCursorPosition())
        end
        if k then
            self.wf_hint:Update(hint_text(self, k, i))
        else
            self.wf_hint:Update()
        end
        return res
    end
end

function on_game_start()
    warfare.on_enabled(install)
end
